<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <title>Xylara Browser</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-2px)} 30%{transform:translateX(2px)} 45%{transform:translateX(-1px)} 60%{transform:translateX(1px)} }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #0a0a0f;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .topbar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 12px;
            background: #0d0d14;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }

        .topbar-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: #8a8a92;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.2s;
        }

        .topbar-btn:hover { background: rgba(255,255,255,0.08); color: #fff; }
        .topbar-btn:active { animation: rumble 0.3s ease; transform: scale(0.9); }
        .topbar-btn:disabled { opacity: 0.3; pointer-events: none; }
        .topbar-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

        .logo-mini {
            font-weight: 900;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: #8b5cf6;
            padding: 0 8px;
            flex-shrink: 0;
            text-decoration: none;
        }

        .address-bar {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 0 14px;
            height: 32px;
            transition: all 0.2s;
            max-width: 600px;
            margin: 0 auto;
        }

        .address-bar:focus-within {
            border-color: #8b5cf6;
            box-shadow: 0 0 20px rgba(139,92,246,0.15);
        }

        .lock-icon { color: #555; font-size: 11px; flex-shrink: 0; letter-spacing: 0.5px; }

        .address-bar input {
            flex: 1;
            background: transparent;
            border: none;
            color: #e8e8f0;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        .address-bar input::placeholder { color: #55555c; }

        .tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            padding: 5px 8px 0;
            background: #0a0a0f;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 8px 8px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: #8a8a92;
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            max-width: 150px;
            min-width: 70px;
            transition: all 0.15s;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
        }

        .tab:hover { background: rgba(255,255,255,0.04); color: #e8e8f0; }
        .tab.active { background: #111118; color: #fff; border-color: rgba(255,255,255,0.08); border-bottom-color: transparent; font-weight: 600; }

        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 14px; height: 14px; border-radius: 50%; border: none;
            background: transparent; color: #555; cursor: pointer;
            font-size: 9px; opacity: 0; transition: all 0.15s; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }

        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.3); color: #ff6b6b; }

        .new-tab-btn {
            width: 24px; height: 24px; border-radius: 6px;
            border: 1px dashed rgba(255,255,255,0.12);
            background: transparent; cursor: pointer; color: #555;
            font-size: 14px; flex-shrink: 0; display: flex;
            align-items: center; justify-content: center;
            margin-left: 3px; margin-bottom: 4px; transition: all 0.2s;
        }

        .new-tab-btn:hover { border-color: #8b5cf6; color: #8b5cf6; background: rgba(139,92,246,0.1); }

        .browser-content { flex: 1; position: relative; background: #000; }
        .browser-content iframe { width: 100%; height: 100%; border: none; display: none; background: #fff; }
        .browser-content iframe.visible { display: block; }

        .new-tab-page {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: #0a0a0f; z-index: 1;
        }
        .new-tab-page.hidden { display: none; }

        .new-tab-logo {
            font-size: 2rem; font-weight: 900; letter-spacing: 5px;
            color: #8b5cf6; margin-bottom: 4px;
        }

        .new-tab-sub { font-size: 0.7rem; color: #555; letter-spacing: 2px; margin-bottom: 24px; text-transform: uppercase; }

        .new-tab-search { display: flex; align-items: center; gap: 8px; max-width: 420px; width: 85%; }

        .new-tab-search input {
            flex: 1; background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px; padding: 12px 16px;
            color: #fff; font-size: 13px; outline: none; font-family: inherit;
        }

        .new-tab-search input:focus { border-color: #8b5cf6; }

        .new-tab-search button {
            background: #8b5cf6; border: none; border-radius: 12px;
            padding: 12px 18px; color: white; font-weight: 700;
            cursor: pointer; font-family: inherit; font-size: 13px;
            transition: all 0.2s;
        }

        .new-tab-search button:hover { background: #a78bfa; }

        .quick-apps { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; justify-content: center; }

        .quick-app {
            width: 52px; height: 52px; border-radius: 12px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.2s;
        }

        .quick-app:hover { background: rgba(139,92,246,0.15); border-color: #8b5cf6; transform: translateY(-2px); }
        .quick-app img { width: 22px; height: 22px; object-fit: contain; border-radius: 4px; }

        @media (max-width: 600px) {
            .logo-mini { display: none; }
            .address-bar { max-width: 100%; }
            .new-tab-logo { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <a href="/" class="logo-mini" title="Home">XYLARA</a>
        <button class="topbar-btn" id="btn-back" disabled title="Back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="topbar-btn" id="btn-forward" disabled title="Forward">
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <button class="topbar-btn" id="btn-refresh" title="Refresh">
            <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>
        <button class="topbar-btn" id="btn-home" title="New Tab">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </button>
        <div class="address-bar">
            <span class="lock-icon">https</span>
            <input type="text" id="url-input" placeholder="Search or enter URL..." autocomplete="off">
        </div>
    </div>

    <div class="tabs-bar" id="tabs-bar">
        <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
    </div>

    <div class="browser-content" id="browser-content">
        <iframe id="Frame" src="" style="display:none;"></iframe>
        <div class="new-tab-page" id="new-tab-page">
            <div class="new-tab-logo">XYLARA</div>
            <div class="new-tab-sub">Browse Freely</div>
            <div class="new-tab-search">
                <input type="text" id="new-tab-search-input" placeholder="Search or enter URL...">
                <button id="new-tab-search-btn">Go</button>
            </div>
            <div class="quick-apps">
                <div class="quick-app" data-url="https://discord.com">
                    <img src="/assets/svg/discord.svg" alt="Discord">
                </div>
                <div class="quick-app" data-url="https://youtube.com">
                    <img src="/assets/svg/youtube.svg" alt="YouTube">
                </div>
                <div class="quick-app" data-url="https://spotify.com">
                    <img src="/assets/svg/spotify.svg" alt="Spotify">
                </div>
                <div class="quick-app" data-url="https://github.com">
                    <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
                </div>
            </div>
        </div>
    </div>

    <script>
        const frameEl = document.getElementById("Frame");
        const urlInput = document.getElementById("url-input");
        const tabsBar = document.getElementById("tabs-bar");
        const newTabBtn = document.getElementById("new-tab-btn");
        const newTabPage = document.getElementById("new-tab-page");

        let tabs = [];
        let activeTabId = null;
        let scramjetFrame = null;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
            getCurrentUrl() {
                if (this.historyIndex >= 0 && this.historyIndex < this.history.length) {
                    return this.history[this.historyIndex];
                }
                return this.url;
            }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) {
                tabs = [];
                addTab(null);
                return;
            }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;

            if (tab.url) {
                frameEl.style.display = 'block';
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frameEl.style.display = 'none';
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }

            document.getElementById('btn-back').disabled = !tab.canGoBack();
            document.getElementById('btn-forward').disabled = !tab.canGoForward();
        }

        function getHostname(url) {
            try {
                return new URL(url.startsWith('http') ? url : 'https://' + url).hostname.replace('www.', '');
            } catch(e) {
                return url.substring(0, 20) || 'New Tab';
            }
        }

        function makeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            
            if (/^https?:\/\//i.test(query)) return query;
            
            if (query.includes('.') && !query.includes(' ')) {
                return 'https://' + query;
            }
            
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            
            try {
                url = new URL(url).toString();
            } catch(e) {
                console.error('Invalid URL:', url);
                return;
            }
            
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            renderTabs();
            
            if (activeTabId === id) {
                loadUrl(url);
            }
        }

        function loadUrl(url) {
            try {
                const parsed = new URL(url);
                url = parsed.toString();
            } catch(e) {
                console.error('Cannot load invalid URL:', url);
                return;
            }
            
            frameEl.style.display = 'block';
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            
            const proxyType = localStorage.getItem('proxy') || 'ultraviolet';
            
            if (proxyType === 'ultraviolet' && typeof __uv$config !== 'undefined') {
                try {
                    const encoded = __uv$config.prefix + __uv$config.encodeUrl(url);
                    frameEl.src = encoded;
                } catch(e) {
                    console.error('UV encode error, falling back to Scramjet:', e);
                    if (scramjetFrame) scramjetFrame.go(url);
                    else frameEl.src = url;
                }
            } else {
                if (scramjetFrame) {
                    scramjetFrame.go(url);
                } else {
                    frameEl.src = url;
                }
            }
        }

        function renderTabs() {
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());
            
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                el.innerHTML = '<span class="tab-title">' + escapeHtml(tab.title || 'New Tab') + '</span>' +
                    (tabs.length > 1 ? '<button class="tab-close">X</button>' : '');
                el.querySelector('.tab-title').addEventListener('click', () => switchTab(tab.id));
                const cb = el.querySelector('.tab-close');
                if (cb) cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                tabsBar.insertBefore(el, newTabBtn);
            });
        }

        function escapeHtml(s) {
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        // Event listeners
        newTabBtn.addEventListener('click', () => addTab(null));

        document.getElementById('btn-home').addEventListener('click', () => {
            addTab(null);
        });

        document.getElementById('btn-refresh').addEventListener('click', () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.url) loadUrl(tab.url);
        });

        document.getElementById('btn-back').addEventListener('click', () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoBack()) {
                tab.historyIndex--;
                const url = tab.history[tab.historyIndex];
                tab.url = url;
                loadUrl(url);
                urlInput.value = url;
                document.getElementById('btn-back').disabled = !tab.canGoBack();
                document.getElementById('btn-forward').disabled = !tab.canGoForward();
            }
        });

        document.getElementById('btn-forward').addEventListener('click', () => {
            const tab = tabs.find(t => t.id === activeTabId);
            if (tab && tab.canGoForward()) {
                tab.historyIndex++;
                const url = tab.history[tab.historyIndex];
                tab.url = url;
                loadUrl(url);
                urlInput.value = url;
                document.getElementById('btn-back').disabled = !tab.canGoBack();
                document.getElementById('btn-forward').disabled = !tab.canGoForward();
            }
        });

        urlInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const url = makeUrl(urlInput.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    else addTab(url);
                }
            }
        });

        document.getElementById('new-tab-search-btn').addEventListener('click', () => {
            const input = document.getElementById('new-tab-search-input');
            const url = makeUrl(input.value);
            if (url) {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab) navigateInTab(activeTabId, url);
                input.value = '';
            }
        });

        document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
        });

        document.querySelectorAll('.quick-app').forEach(app => {
            app.addEventListener('click', () => {
                let url = app.dataset.url;
                if (!url) return;
                if (!url.startsWith('http://') && !url.startsWith('https://')) {
                    url = 'https://' + url;
                }
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab) navigateInTab(activeTabId, url);
                else addTab(url);
            });
        });

        // Initialize
        async function init() {
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}

            try {
                await navigator.serviceWorker.ready;
                const serviceworker = navigator.serviceWorker.controller ?? (await navigator.serviceWorker.ready).active;
                let wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                let EpoxyTransport;
                if (self.EpoxyTransport) {
                    EpoxyTransport = self.EpoxyTransport.EpoxyTransport || self.EpoxyTransport.default || self.EpoxyTransport;
                } else {
                    const epoxyModule = await import('/epoxy/index.mjs');
                    EpoxyTransport = epoxyModule.EpoxyTransport || epoxyModule.default;
                }
                const transport = new EpoxyTransport({ wisp: wispUrl });
                await transport.init();
                const { Controller } = $scramjetController;
                const { defaultConfig } = $scramjet;
                const scramjet = new Controller({ serviceworker, transport, scramjetConfig: defaultConfig });
                await scramjet.wait();
                window.sj = scramjet;
                scramjetFrame = scramjet.createFrame(frameEl);
            } catch (error) {}

            const savedUrl = localStorage.getItem("url");
            if (savedUrl) {
                localStorage.removeItem("url");
                let finalUrl = savedUrl;
                try {
                    finalUrl = new URL(savedUrl).toString();
                } catch(e) {
                    if (!finalUrl.startsWith('http')) finalUrl = 'https://' + finalUrl;
                }
                addTab(finalUrl);
            } else {
                addTab(null);
            }
        }

        document.addEventListener("DOMContentLoaded", init);
    </script>
</body>
</html>
