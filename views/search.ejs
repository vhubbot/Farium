<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>

    <title>Xylara</title>

    <style>
        :root {
            --purple: #8b5cf6;
            --light-purple: #c4b5fd;
            --panel: rgba(10, 10, 22, 0.9);
            --border: rgba(255, 255, 255, 0.16);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: #000;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        iframe {
            position: fixed;
            inset: 0;
            z-index: 1;
            width: 100vw;
            height: 100vh;
            border: none;
            background: #000;
        }

        .toolbar {
            position: fixed;
            top: 16px;
            left: 18px;
            z-index: 20;
            display: flex;
            align-items: center;
            gap: 7px;
            max-width: calc(100vw - 36px);
            padding: 7px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background:
                linear-gradient(
                    120deg,
                    rgba(255, 255, 255, 0.08),
                    transparent 45%,
                    rgba(139, 92, 246, 0.16)
                ),
                var(--panel);
            box-shadow:
                0 16px 40px rgba(0, 0, 0, 0.45),
                0 0 28px rgba(139, 92, 246, 0.14),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .toolbar.hidden {
            display: none;
        }

        .control-button,
        .floating-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: 1px solid rgba(255, 255, 255, 0.14);
            outline: none;
            color: rgba(255, 255, 255, 0.86);
            background: rgba(255, 255, 255, 0.07);
            cursor: pointer;
            transition: all 0.22s ease;
        }

        .control-button {
            width: 36px;
            height: 36px;
            border-radius: 11px;
        }

        .control-button:hover,
        .floating-toggle:hover {
            color: #fff;
            border-color: var(--light-purple);
            background: rgba(139, 92, 246, 0.34);
            box-shadow: 0 0 18px rgba(139, 92, 246, 0.3);
            transform: translateY(-2px);
        }

        .control-button:active,
        .floating-toggle:active {
            transform: scale(0.92);
        }

        .control-button svg,
        .floating-toggle svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .search-box {
            display: flex;
            align-items: center;
            width: min(42vw, 390px);
            height: 36px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 11px;
            background: rgba(0, 0, 0, 0.28);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .search-box:focus-within {
            border-color: var(--light-purple);
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.25);
        }

        #url-input {
            flex: 1;
            min-width: 0;
            height: 100%;
            padding: 0 14px;
            border: none;
            outline: none;
            color: #fff;
            background: transparent;
            font: inherit;
            font-size: 0.82rem;
        }

        #url-input::placeholder {
            color: rgba(255, 255, 255, 0.52);
        }

        .go-button {
            height: 100%;
            padding: 0 16px;
            border: none;
            color: #fff;
            background: linear-gradient(135deg, #9b6cff, #7040dc);
            cursor: pointer;
            font: inherit;
            font-size: 0.78rem;
            font-weight: 800;
            transition: background 0.2s ease;
        }

        .go-button:hover {
            background: linear-gradient(135deg, #b39aff, #8555ef);
        }

        .floating-toggle {
            position: fixed;
            top: 16px;
            right: 18px;
            z-index: 30;
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background:
                linear-gradient(135deg, rgba(155, 108, 255, 0.95), rgba(112, 64, 220, 0.95));
            box-shadow:
                0 10px 28px rgba(0, 0, 0, 0.4),
                0 0 22px rgba(139, 92, 246, 0.4);
            touch-action: none;
            user-select: none;
        }

        .floating-toggle.dragging {
            cursor: grabbing;
            transform: scale(1.08);
        }

        .status {
            position: fixed;
            right: 18px;
            bottom: 15px;
            z-index: 10;
            padding: 8px 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: rgba(255, 255, 255, 0.55);
            background: rgba(10, 10, 20, 0.68);
            font-size: 10px;
            letter-spacing: 1px;
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        @media (max-width: 700px) {
            .toolbar {
                top: 12px;
                left: 12px;
                right: 12px;
                max-width: none;
            }

            .search-box {
                width: auto;
                flex: 1;
            }

            .control-button {
                width: 33px;
                height: 33px;
            }

            .go-button {
                padding: 0 11px;
            }

            .floating-toggle {
                top: 12px;
                right: 12px;
            }
        }

        @media (max-width: 470px) {
            .toolbar {
                gap: 4px;
                padding: 5px;
            }

            .control-button {
                width: 30px;
                height: 30px;
                border-radius: 9px;
            }

            .control-button svg {
                width: 15px;
                height: 15px;
            }

            #url-input {
                padding: 0 9px;
                font-size: 0.73rem;
            }

            .go-button {
                padding: 0 9px;
                font-size: 0.7rem;
            }

            .status {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar" id="toolbar">
        <button class="control-button" id="back-button" title="Go back" aria-label="Go back">
            <svg viewBox="0 0 24 24">
                <path d="m15 18-6-6 6-6"></path>
            </svg>
        </button>

        <button class="control-button" id="forward-button" title="Go forward" aria-label="Go forward">
            <svg viewBox="0 0 24 24">
                <path d="m9 18 6-6-6-6"></path>
            </svg>
        </button>

        <button class="control-button" id="refresh-button" title="Refresh" aria-label="Refresh">
            <svg viewBox="0 0 24 24">
                <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4"></path>
                <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4"></path>
            </svg>
        </button>

        <button class="control-button" id="home-button" title="Home" aria-label="Home">
            <svg viewBox="0 0 24 24">
                <path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"></path>
                <path d="M9 20v-6h6v6"></path>
            </svg>
        </button>

        <div class="search-box">
            <input
                type="text"
                id="url-input"
                placeholder="Search or enter a URL..."
                autocomplete="off"
            >
            <button class="go-button" id="go-button">Go</button>
        </div>
    </div>

    <button class="floating-toggle" id="floating-toggle" title="Show controls" aria-label="Show controls">
        <svg viewBox="0 0 24 24">
            <path d="M4 12h16"></path>
            <path d="m10 6-6 6 6 6"></path>
        </svg>
    </button>

    <div class="status">XYLARA</div>

    <iframe id="Frame" src="" title="Xylara browser"></iframe>

    <script>
        const frameEl = document.getElementById("Frame");
        const input = document.getElementById("url-input");
        const toolbar = document.getElementById("toolbar");
        const floatingToggle = document.getElementById("floating-toggle");

        let scramjetFrame = null;
        let isDragging = false;
        let moved = false;
        let offsetX = 0;
        let offsetY = 0;

        async function handleNavigation(query) {
            const originalQuery = query.trim();
            if (!originalQuery) return;

            let url = originalQuery;

            if (!url.includes(".") || url.includes(" ")) {
                url = (localStorage.getItem("search") || "https://www.google.com/search?q=")
                    + encodeURIComponent(originalQuery);
            } else if (!/^https?:\/\//i.test(url)) {
                url = "https://" + url;
            }

            const proxyType = localStorage.getItem("proxy") || "ultraviolet";

            if (proxyType === "ultraviolet") {
                const encoded = __uv$config.prefix + __uv$config.encodeUrl(url);
                localStorage.setItem("url", encoded);
                frameEl.src = encoded;
            } else if (scramjetFrame) {
                localStorage.setItem("url", url);
                scramjetFrame.go(url);
            }

            input.value = url;
            input.blur();
        }

        function frameHistory(action) {
            try {
                if (scramjetFrame && typeof scramjetFrame[action] === "function") {
                    scramjetFrame[action]();
                } else {
                    frameEl.contentWindow.history[action]();
                }
            } catch (error) {
                console.warn("Frame history is unavailable:", error);
            }
        }

        function refreshFrame() {
            try {
                if (scramjetFrame && typeof scramjetFrame.reload === "function") {
                    scramjetFrame.reload();
                } else {
                    frameEl.contentWindow.location.reload();
                }
            } catch (error) {
                frameEl.src = frameEl.src;
            }
        }

        function showToolbar() {
            toolbar.classList.remove("hidden");
            floatingToggle.title = "Hide controls";
            floatingToggle.setAttribute("aria-label", "Hide controls");
        }

        function hideToolbar() {
            toolbar.classList.add("hidden");
            floatingToggle.title = "Show controls";
            floatingToggle.setAttribute("aria-label", "Show controls");
        }

        function toggleToolbar() {
            if (toolbar.classList.contains("hidden")) {
                showToolbar();
            } else {
                hideToolbar();
            }
        }

        function positionToggle(clientX, clientY) {
            const buttonWidth = floatingToggle.offsetWidth;
            const buttonHeight = floatingToggle.offsetHeight;

            const left = Math.max(
                0,
                Math.min(clientX - offsetX, window.innerWidth - buttonWidth)
            );

            const top = Math.max(
                0,
                Math.min(clientY - offsetY, window.innerHeight - buttonHeight)
            );

            floatingToggle.style.left = `${left}px`;
            floatingToggle.style.top = `${top}px`;
            floatingToggle.style.right = "auto";
        }

        function startDragging(event) {
            const rect = floatingToggle.getBoundingClientRect();

            isDragging = true;
            moved = false;
            offsetX = event.clientX - rect.left;
            offsetY = event.clientY - rect.top;

            floatingToggle.classList.add("dragging");
            floatingToggle.setPointerCapture(event.pointerId);
        }

        function dragToggle(event) {
            if (!isDragging) return;

            if (
                Math.abs(event.clientX - (offsetX + floatingToggle.offsetLeft)) > 3 ||
                Math.abs(event.clientY - (offsetY + floatingToggle.offsetTop)) > 3
            ) {
                moved = true;
            }

            positionToggle(event.clientX, event.clientY);
        }

        function stopDragging(event) {
            if (!isDragging) return;

            isDragging = false;
            floatingToggle.classList.remove("dragging");

            if (floatingToggle.hasPointerCapture(event.pointerId)) {
                floatingToggle.releasePointerCapture(event.pointerId);
            }

            if (!moved) {
                toggleToolbar();
            }
        }

        async function init() {
            if ("serviceWorker" in navigator) {
                try {
                    await navigator.serviceWorker.register("/sw.js");
                    await navigator.serviceWorker.ready;
                } catch (error) {
                    console.error("SW registration error:", error);
                }
            }

            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") ||
                    `${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/wisp/`;
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy"
                    ? "/epoxy/index.mjs"
                    : "/libcurl/index.mjs";

                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (error) {
                console.error("BareMux init error:", error);
            }

            try {
                await navigator.serviceWorker.ready;

                const serviceworker = navigator.serviceWorker.controller ||
                    (await navigator.serviceWorker.ready).active;

                const wispUrl = localStorage.getItem("wisp") ||
                    `${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/wisp/`;

                let EpoxyTransport;

                if (self.EpoxyTransport) {
                    EpoxyTransport = self.EpoxyTransport.EpoxyTransport ||
                        self.EpoxyTransport.default ||
                        self.EpoxyTransport;
                } else {
                    const epoxyModule = await import("/epoxy/index.mjs");
                    EpoxyTransport = epoxyModule.EpoxyTransport || epoxyModule.default;
                }

                const transport = new EpoxyTransport({ wisp: wispUrl });
                await transport.init();

                const { Controller } = $scramjetController;
                const { defaultConfig } = $scramjet;

                const scramjet = new Controller({
                    serviceworker,
                    transport,
                    scramjetConfig: defaultConfig
                });

                await scramjet.wait();

                window.sj = scramjet;
                scramjetFrame = scramjet.createFrame(frameEl);

                const savedUrl = localStorage.getItem("url");
                const proxyType = localStorage.getItem("proxy") || "ultraviolet";

                if (savedUrl) {
                    if (proxyType === "scramjet" || !savedUrl.startsWith(__uv$config.prefix)) {
                        const target = savedUrl.startsWith("http")
                            ? savedUrl
                            : "https://example.com";

                        scramjetFrame.go(target);
                        input.value = target;
                    } else {
                        frameEl.src = savedUrl;
                        input.value = savedUrl;
                    }
                }
            } catch (error) {
                console.error("Scramjet initialization error:", error);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            init();

            document.getElementById("back-button").addEventListener("click", () => {
                frameHistory("back");
            });

            document.getElementById("forward-button").addEventListener("click", () => {
                frameHistory("forward");
            });

            document.getElementById("refresh-button").addEventListener("click", refreshFrame);

            document.getElementById("home-button").addEventListener("click", () => {
                localStorage.removeItem("url");
                window.location.href = "/";
            });

            document.getElementById("go-button").addEventListener("click", () => {
                handleNavigation(input.value);
            });

            input.addEventListener("keydown", event => {
                if (event.key === "Enter") {
                    handleNavigation(input.value);
                }
            });

            floatingToggle.addEventListener("pointerdown", startDragging);
            floatingToggle.addEventListener("pointermove", dragToggle);
            floatingToggle.addEventListener("pointerup", stopDragging);
            floatingToggle.addEventListener("pointercancel", stopDragging);
        });
    </script>
</body>
</html>
