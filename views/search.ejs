<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>

    <title>Xylara Browser</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        :root {
            --panel: rgba(17, 17, 28, .94);
            --panel-light: rgba(255, 255, 255, .08);
            --border: rgba(255, 255, 255, .14);
            --purple: #8b5cf6;
            --purple-light: #b49aff;
            --text-muted: rgba(255, 255, 255, .58);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: #050509;
            color: white;
            font-family: Inter, sans-serif;
        }

        button,
        input {
            font: inherit;
        }

        iframe {
            position: fixed;
            inset: 0;
            z-index: 1;
            width: 100vw;
            height: 100vh;
            border: 0;
            background: white;
        }

        .browser-shell {
            position: fixed;
            top: 12px;
            left: 50%;
            z-index: 20;
            width: min(980px, calc(100% - 24px));
            transform: translateX(-50%);
            transition: .3s ease;
        }

        .browser-shell.hidden {
            transform: translate(-50%, -150%);
            opacity: 0;
            pointer-events: none;
        }

        .browser-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px;
            border: 1px solid var(--border);
            border-radius: 17px;
            background: var(--panel);
            box-shadow: 0 18px 50px rgba(0, 0, 0, .45);
            backdrop-filter: blur(24px);
        }

        .browser-button,
        .new-tab,
        .close-tab {
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border: 0;
            color: rgba(255, 255, 255, .72);
            background: transparent;
            cursor: pointer;
            transition: .2s ease;
        }

        .browser-button {
            width: 37px;
            height: 37px;
            border-radius: 11px;
        }

        .browser-button:hover,
        .new-tab:hover {
            color: white;
            background: rgba(139, 92, 246, .32);
            transform: translateY(-1px);
        }

        .browser-button.home {
            color: white;
            background: linear-gradient(135deg, #a27aff, #7140dc);
            box-shadow: 0 5px 18px rgba(139, 92, 246, .35);
        }

        .browser-button:active,
        .new-tab:active {
            transform: scale(.9);
        }

        svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .separator {
            width: 1px;
            height: 23px;
            margin: 0 2px;
            background: rgba(255, 255, 255, .14);
        }

        .address-box {
            display: flex;
            align-items: center;
            flex: 1;
            min-width: 120px;
            height: 37px;
            padding: 0 11px;
            border: 1px solid rgba(255, 255, 255, .1);
            border-radius: 11px;
            background: rgba(0, 0, 0, .28);
            transition: .2s ease;
        }

        .address-box:focus-within {
            border-color: var(--purple-light);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, .14);
        }

        .address-icon {
            width: 15px;
            height: 15px;
            margin-right: 9px;
            color: var(--text-muted);
        }

        #url-input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            color: white;
            background: transparent;
            font-size: .8rem;
        }

        #url-input::placeholder {
            color: rgba(255, 255, 255, .42);
        }

        .go-button {
            display: grid;
            place-items: center;
            width: 29px;
            height: 29px;
            margin-left: 6px;
            border: 0;
            border-radius: 8px;
            color: white;
            background: var(--purple);
            cursor: pointer;
            transition: .2s ease;
        }

        .go-button:hover {
            background: var(--purple-light);
            transform: scale(1.06);
        }

        .go-button svg {
            width: 15px;
            height: 15px;
        }

        .tabs-panel {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 7px;
            padding: 6px;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--panel);
            box-shadow: 0 12px 35px rgba(0, 0, 0, .3);
            scrollbar-width: thin;
        }

        .tab {
            display: flex;
            align-items: center;
            gap: 7px;
            min-width: 145px;
            max-width: 220px;
            height: 34px;
            padding: 0 8px;
            border: 1px solid transparent;
            border-radius: 10px;
            color: var(--text-muted);
            background: rgba(255, 255, 255, .055);
            cursor: pointer;
            transition: .2s ease;
        }

        .tab:hover,
        .tab.active {
            color: white;
            border-color: rgba(180, 154, 255, .48);
            background: rgba(139, 92, 246, .25);
        }

        .tab-favicon {
            width: 17px;
            height: 17px;
            flex: 0 0 auto;
            border-radius: 4px;
            object-fit: contain;
        }

        .tab-title {
            flex: 1;
            overflow: hidden;
            font-size: .72rem;
            text-align: left;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .close-tab {
            width: 20px;
            height: 20px;
            border-radius: 6px;
            font-size: 16px;
            line-height: 1;
        }

        .close-tab:hover {
            color: white;
            background: rgba(255, 255, 255, .16);
        }

        .new-tab {
            width: 34px;
            height: 34px;
            flex: 0 0 auto;
            border-radius: 10px;
            color: white;
            font-size: 21px;
            line-height: 1;
        }

        .toolbar-toggle {
            position: fixed;
            top: 14px;
            right: 16px;
            z-index: 30;
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 12px;
            color: white;
            background: var(--panel);
            box-shadow: 0 10px 28px rgba(0, 0, 0, .35);
            backdrop-filter: blur(20px);
            cursor: pointer;
            transition: .2s ease;
        }

        .toolbar-toggle:hover {
            background: rgba(139, 92, 246, .35);
            transform: translateY(-2px);
        }

        .toolbar-toggle svg {
            transition: .3s ease;
        }

        .toolbar-toggle.collapsed svg {
            transform: rotate(180deg);
        }

        @media (max-width: 650px) {
            .browser-shell {
                top: 8px;
                width: calc(100% - 16px);
            }

            .browser-bar {
                flex-wrap: wrap;
                border-radius: 14px;
            }

            .browser-button {
                width: 34px;
                height: 34px;
            }

            .address-box {
                order: 2;
                flex-basis: 100%;
                height: 35px;
            }

            .tabs-panel {
                margin-top: 5px;
            }

            .tab {
                min-width: 125px;
            }

            .toolbar-toggle {
                top: 8px;
                right: 8px;
                width: 36px;
                height: 36px;
            }
        }
    </style>
</head>
<body>
    <button class="toolbar-toggle" id="toolbar-toggle" title="Hide browser controls" aria-label="Hide browser controls">
        <svg viewBox="0 0 24 24">
            <path d="m6 9 6 6 6-6"/>
        </svg>
    </button>

    <main class="browser-shell" id="browser-shell">
        <div class="browser-bar">
            <button class="browser-button home" id="home-button" title="Home" aria-label="Go home">
                <svg viewBox="0 0 24 24">
                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/>
                    <path d="M9 21v-6h6v6"/>
                </svg>
            </button>

            <button class="browser-button" id="back-button" title="Back" aria-label="Go back">
                <svg viewBox="0 0 24 24">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>

            <button class="browser-button" id="forward-button" title="Forward" aria-label="Go forward">
                <svg viewBox="0 0 24 24">
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </button>

            <button class="browser-button" id="refresh-button" title="Refresh" aria-label="Refresh">
                <svg viewBox="0 0 24 24">
                    <path d="M20 11a8 8 0 0 0-15.5-2M4 5v4h4"/>
                    <path d="M4 13a8 8 0 0 0 15.5 2M20 19v-4h-4"/>
                </svg>
            </button>

            <span class="separator"></span>

            <div class="address-box">
                <svg class="address-icon" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m20 20-4-4"/>
                </svg>

                <input id="url-input" type="text" placeholder="Search or enter a URL..."
                    autocomplete="off" spellcheck="false">

                <button class="go-button" id="go-button" title="Go" aria-label="Go">
                    <svg viewBox="0 0 24 24">
                        <path d="m5 12 14-7-4 14-3-6z"/>
                        <path d="m12 13 7-8"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="tabs-panel" id="tabs-panel">
            <button class="new-tab" id="new-tab" title="New tab" aria-label="New tab">+</button>
        </div>
    </main>

    <iframe id="Frame" title="Xylara browser"></iframe>

    <script>
        const frame = document.getElementById("Frame");
        const input = document.getElementById("url-input");
        const shell = document.getElementById("browser-shell");
        const toggle = document.getElementById("toolbar-toggle");
        const tabsPanel = document.getElementById("tabs-panel");

        let scramjetFrame = null;
        let activeTab = 0;
        let tabs = [{ title: "New Tab", url: "", icon: "" }];

        const defaultWisp = () =>
            `${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/wisp/`;

        function favicon(url) {
            try {
                return `https://www.google.com/s2/favicons?domain=${
                    encodeURIComponent(new URL(url).hostname)
                }&sz=64`;
            } catch {
                return "";
            }
        }

        function saveTabs() {
            localStorage.setItem("browserTabs", JSON.stringify(tabs));
            localStorage.setItem("activeBrowserTab", String(activeTab));
        }

        function renderTabs() {
            tabsPanel.querySelectorAll(".tab").forEach(tab => tab.remove());

            tabs.forEach((tab, index) => {
                const element = document.createElement("div");
                element.className = `tab${index === activeTab ? " active" : ""}`;
                element.title = tab.url || "New Tab";

                if (tab.icon) {
                    const image = document.createElement("img");
                    image.className = "tab-favicon";
                    image.src = tab.icon;
                    image.alt = "";
                    element.appendChild(image);
                }

                const title = document.createElement("span");
                title.className = "tab-title";
                title.textContent = tab.title;
                element.appendChild(title);

                const close = document.createElement("button");
                close.className = "close-tab";
                close.type = "button";
                close.title = "Close tab";
                close.textContent = "×";

                close.addEventListener("click", event => {
                    event.stopPropagation();
                    closeTab(index);
                });

                element.appendChild(close);

                element.addEventListener("click", () => switchTab(index));
                tabsPanel.insertBefore(element, document.getElementById("new-tab"));
            });

            saveTabs();
        }

        function switchTab(index) {
            activeTab = index;
            const tab = tabs[activeTab];

            if (tab.url) {
                input.value = tab.url;
                loadProxyPage(tab.url);
            } else {
                input.value = "";
                frame.src = "";
                localStorage.removeItem("url");
            }

            renderTabs();
        }

        function closeTab(index) {
            if (tabs.length === 1) {
                tabs[0] = { title: "New Tab", url: "", icon: "" };
                activeTab = 0;
                frame.src = "";
                input.value = "";
            } else {
                tabs.splice(index, 1);
                if (activeTab >= tabs.length) activeTab = tabs.length - 1;
                if (index <= activeTab && activeTab > 0) activeTab--;
                switchTab(activeTab);
            }

            renderTabs();
        }

        function newTab() {
            tabs.push({ title: "New Tab", url: "", icon: "" });
            activeTab = tabs.length - 1;
            frame.src = "";
            input.value = "";
            localStorage.removeItem("url");
            renderTabs();
            input.focus();
        }

        function updateTab(url, title) {
            tabs[activeTab] = {
                title: title || new URL(url).hostname,
                url,
                icon: favicon(url)
            };

            input.value = url;
            renderTabs();
        }

        function loadProxyPage(url) {
            const proxy = localStorage.getItem("proxy") || "ultraviolet";

            if (proxy === "ultraviolet") {
                const encoded = __uv$config.prefix + __uv$config.encodeUrl(url);
                localStorage.setItem("url", encoded);
                frame.src = encoded;
            } else if (scramjetFrame) {
                localStorage.setItem("url", url);
                scramjetFrame.go(url);
            }
        }

        function parseQuery(value) {
            const query = value.trim();
            if (!query) return "";

            if (/^https?:\/\//i.test(query)) return query;

            if (query.includes(".") && !query.includes(" ")) {
                return `https://${query}`;
            }

            const engine = localStorage.getItem("search") ||
                "https://www.google.com/search?q=";

            return engine + encodeURIComponent(query);
        }

        function navigate() {
            const target = parseQuery(input.value);
            if (!target) return;

            loadProxyPage(target);

            let title = target;
            try {
                title = new URL(target).hostname;
            } catch {}

            updateTab(target, title);
            input.blur();
        }

        function historyMove(direction) {
            try {
                if (scramjetFrame) {
                    const method = direction < 0 ? "goBack" : "goForward";
                    if (typeof scramjetFrame[method] === "function") {
                        scramjetFrame[method]();
                        return;
                    }
                }

                frame.contentWindow.history.go(direction);
            } catch (error) {
                console.warn("Browser history unavailable:", error);
            }
        }

        function refresh() {
            const current = tabs[activeTab]?.url;
            if (!current) return;

            if (scramjetFrame && typeof scramjetFrame.reload === "function") {
                scramjetFrame.reload();
            } else {
                frame.src = frame.src;
            }
        }

        async function initProxy() {
            if ("serviceWorker" in navigator) {
                try {
                    await navigator.serviceWorker.register("/sw.js");
                    await navigator.serviceWorker.ready;
                } catch (error) {
                    console.error("Service worker error:", error);
                }
            }

            try {
                const mux = new BareMux.BareMuxConnection("/baremux/worker.js");
                const transport = localStorage.getItem("transport") || "libcurl";
                const path = transport === "epoxy"
                    ? "/epoxy/index.mjs"
                    : "/libcurl/index.mjs";

                if (await mux.getTransport() !== path) {
                    await mux.setTransport(path, [{ wisp: localStorage.getItem("wisp") || defaultWisp() }]);
                }
            } catch (error) {
                console.error("Transport error:", error);
            }

            try {
                const serviceworker = navigator.serviceWorker.controller ||
                    (await navigator.serviceWorker.ready).active;

                let EpoxyTransport = self.EpoxyTransport;
                if (EpoxyTransport) {
                    EpoxyTransport = EpoxyTransport.EpoxyTransport ||
                        EpoxyTransport.default ||
                        EpoxyTransport;
                } else {
                    const module = await import("/epoxy/index.mjs");
                    EpoxyTransport = module.EpoxyTransport || module.default;
                }

                const transport = new EpoxyTransport({
                    wisp: localStorage.getItem("wisp") || defaultWisp()
                });

                await transport.init();

                const scramjet = new $scramjetController.Controller({
                    serviceworker,
                    transport,
                    scramjetConfig: $scramjet.defaultConfig
                });

                await scramjet.wait();
                scramjetFrame = scramjet.createFrame(frame);

                const saved = tabs[activeTab]?.url;
                if (saved) loadProxyPage(saved);
            } catch (error) {
                console.error("Scramjet initialization error:", error);
            }
        }

        toggle.addEventListener("click", () => {
            const hidden = shell.classList.toggle("hidden");
            toggle.classList.toggle("collapsed", hidden);
            toggle.title = hidden ? "Show browser controls" : "Hide browser controls";
            toggle.setAttribute("aria-label", toggle.title);
        });

        document.getElementById("home-button").addEventListener("click", () => {
            location.href = "/";
        });

        document.getElementById("back-button").addEventListener("click", () => historyMove(-1));
        document.getElementById("forward-button").addEventListener("click", () => historyMove(1));
        document.getElementById("refresh-button").addEventListener("click", refresh);
        document.getElementById("go-button").addEventListener("click", navigate);
        document.getElementById("new-tab").addEventListener("click", newTab);

        input.addEventListener("keydown", event => {
            if (event.key === "Enter") navigate();
        });

        try {
            const storedTabs = JSON.parse(localStorage.getItem("browserTabs") || "null");
            if (Array.isArray(storedTabs) && storedTabs.length) {
                tabs = storedTabs;
                activeTab = Math.min(
                    Number(localStorage.getItem("activeBrowserTab")) || 0,
                    tabs.length - 1
                );
            }
        } catch {}

        renderTabs();
        document.addEventListener("DOMContentLoaded", initProxy);
    </script>
</body>
</html>
