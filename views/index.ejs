```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farius</title>
    
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-main: #030305;
            --surface-1: rgba(18, 18, 22, 0.75);
            --surface-2: rgba(30, 30, 36, 0.85);
            --accent-glow: rgba(255, 255, 255, 0.12);
            --border-color: rgba(255, 255, 255, 0.1);
            --border-hover: rgba(255, 255, 255, 0.3);
            --text-primary: #ffffff;
            --text-secondary: #8a8a93;
        }

        /* KEYFRAME ANIMATIONS */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
        @keyframes rumble { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-2px); } 40% { transform: translateX(2px); } 60% { transform: translateX(-1px); } 80% { transform: translateX(1px); } }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes browserSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes glowPulse { 0%, 100% { box-shadow: 0 0 15px rgba(255,255,255,0.05); } 50% { box-shadow: 0 0 30px rgba(255,255,255,0.18); } }
        @keyframes logoShine {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-main) !important;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.03), transparent 70%),
                        linear-gradient(180deg, #000000 0%, #050508 100%);
            z-index: 0;
            pointer-events: none;
        }

        #particle-canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.6;
        }

        .main-content, .topbar, .browser-overlay, .venusFooter, .farium-chat-launch, .chat-overlay {
            z-index: 10;
        }

        /* TOPBAR */
        .topbar {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 6px 12px;
            backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            animation: fadeIn 0.6s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
            text-decoration: none;
        }

        .topbar a:hover, .topbar a.active {
            background: rgba(255,255,255,0.1);
            transform: translateY(-2px);
        }

        .topbar svg {
            width: 18px;
            height: 18px;
            stroke: #fff;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* MAIN CONTENT & ANIMATED LOGO */
        .main-content {
            position: relative;
            text-align: center;
            animation: fadeIn 0.8s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-container {
            margin-bottom: 8px;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        /* FARIUS TEXT LOGO WITH GLOW & SHINE ANIMATION */
        .farius-text-logo {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: 12px;
            text-transform: uppercase;
            background: linear-gradient(120deg, #ffffff 0%, #8a8a93 30%, #ffffff 60%, #44444c 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: logoShine 6s linear infinite;
            filter: drop-shadow(0 0 25px rgba(255,255,255,0.15));
            cursor: default;
            transition: transform 0.4s ease, filter 0.4s ease;
        }

        .logo-container:hover .farius-text-logo {
            transform: scale(1.03);
            filter: drop-shadow(0 0 35px rgba(255,255,255,0.3));
        }

        .tagline {
            font-size: 0.75rem;
            color: var(--text-secondary);
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 32px;
            font-weight: 600;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        /* SEARCH CONTAINER */
        .search-container {
            display: flex;
            align-items: center;
            max-width: 540px;
            margin: 0 auto;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 6px;
            backdrop-filter: blur(25px);
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 0 20px 50px rgba(0,0,0,0.9);
        }

        .search-container:focus-within {
            border-color: var(--border-hover);
            box-shadow: 0 0 35px rgba(255, 255, 255, 0.12), 0 20px 50px rgba(0,0,0,0.9);
            transform: translateY(-2px);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 14px 20px;
            font-size: 0.95rem;
            outline: none;
            background: transparent;
            color: #fff;
            font-family: inherit;
        }

        .search-input::placeholder { color: rgba(255,255,255,0.35); }

        .search-button {
            background: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 12px 22px;
            cursor: pointer;
            outline: none;
            color: #000;
            font-size: 14px;
            font-weight: 800;
            transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
            font-family: inherit;
        }

        .search-button:hover { 
            background: #e0e0e0; 
            transform: translateY(-1px);
            box-shadow: 0 5px 20px rgba(255,255,255,0.2);
        }

        .search-button:active { transform: scale(0.95); }

        /* APP BUTTONS */
        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 28px;
            gap: 12px;
            flex-wrap: wrap;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 16px;
            background: var(--surface-1);
            backdrop-filter: blur(15px);
            cursor: pointer;
            outline: none;
            border: 1px solid var(--border-color);
            color: white;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            overflow: hidden;
        }

        .app-button:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--border-hover);
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.8), 0 0 15px rgba(255,255,255,0.08);
        }

        .app-button:active { transform: scale(0.92); }
        .app-button img { width: 22px; height: 22px; object-fit: contain; opacity: 0.8; transition: opacity 0.2s; }
        .app-button:hover img { opacity: 1; }

        #add-app-button {
            background: var(--surface-1);
            border: 1px dashed var(--border-color);
        }

        #add-app-button:hover {
            border-color: var(--border-hover);
            background: rgba(255, 255, 255, 0.08);
        }

        /* RETURN BUTTON */
        .hohogames-back {
            position: fixed;
            left: 22px;
            bottom: 22px;
            z-index: 120;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 18px;
            color: #fff;
            text-decoration: none;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.8);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .hohogames-back:hover {
            transform: translateY(-3px);
            border-color: var(--border-hover);
            box-shadow: 0 20px 40px rgba(0,0,0,0.9), 0 0 20px rgba(255,255,255,0.05);
        }

        .hohogames-back-icon {
            font-size: 16px;
            transition: transform 0.3s ease;
        }

        .hohogames-back:hover .hohogames-back-icon {
            transform: translateX(-3px);
        }

        .hohogames-back-text strong {
            display: block;
            font-size: 11px;
            letter-spacing: 1.5px;
        }

        .hohogames-back-text small {
            color: var(--text-secondary);
            font-size: 9px;
            letter-spacing: 1px;
        }

        /* BROWSER OVERLAY */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #000000;
        }

        .browser-overlay.open {
            display: flex;
            animation: browserSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            background: #08080a;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .browser-toolbar button {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .browser-toolbar button:hover { background: rgba(255,255,255,0.08); color: #fff; }

        .browser-toolbar svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0 14px;
            height: 34px;
            transition: all 0.2s;
        }

        .browser-address:focus-within {
            border-color: var(--border-hover);
            box-shadow: 0 0 15px rgba(255,255,255,0.08);
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        /* TABS BAR */
        .tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            padding: 6px 10px 0;
            background: #040406;
            border-bottom: 1px solid var(--border-color);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 10px 10px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            max-width: 160px;
            min-width: 80px;
            transition: all 0.2s;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
        }

        .tab:hover { background: rgba(255,255,255,0.04); color: #fff; }
        .tab.active { background: #0e0e12; color: #fff; border-color: var(--border-color); border-bottom-color: transparent; font-weight: 600; }

        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 9px;
            opacity: 0;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(255,255,255,0.15); color: #fff; }

        .new-tab-btn {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            border: 1px dashed var(--border-color);
            background: transparent;
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 4px;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .new-tab-btn:hover { border-color: var(--border-hover); color: #fff; background: rgba(255,255,255,0.05); }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: #000;
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }

        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #000000;
            z-index: 1;
        }

        .new-tab-page.hidden { display: none; }

        .new-tab-sub { font-size: 0.75rem; color: var(--text-secondary); letter-spacing: 3px; margin-bottom: 24px; text-transform: uppercase; }

        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 420px;
            width: 85%;
        }

        .new-tab-search input {
            flex: 1;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px 18px;
            color: #fff;
            font-size: 13px;
            outline: none;
            font-family: inherit;
        }

        .new-tab-search input:focus { border-color: var(--border-hover); }

        .new-tab-search button {
            background: #fff;
            border: none;
            border-radius: 12px;
            padding: 12px 20px;
            color: #000;
            font-weight: 800;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            transition: all 0.2s;
        }

        .new-tab-search button:hover { background: #e0e0e0; }

        /* CHAT OVERLAY */
        .farium-chat-launch {
            position: fixed;
            right: 22px;
            bottom: 22px;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 12px 18px;
            color: #fff;
            background: var(--surface-1);
            backdrop-filter: blur(20px);
            cursor: pointer;
            box-shadow: 0 12px 35px rgba(0,0,0,0.8);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            font: 600 12px Inter, sans-serif;
        }

        .farium-chat-launch:hover {
            transform: translateY(-3px);
            border-color: var(--border-hover);
            box-shadow: 0 18px 40px rgba(0,0,0,0.9), 0 0 20px rgba(255,255,255,0.08);
        }

        .chat-launch-icon { color: #fff; font-size: 10px; opacity: 0.8; }

        .chat-overlay {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: 22px;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(8px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .chat-overlay.open { opacity: 1; visibility: visible; pointer-events: auto; }

        .chat-window {
            width: min(900px, calc(100vw - 30px));
            height: min(650px, calc(100vh - 45px));
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border-color);
            border-radius: 24px;
            background: rgba(10, 10, 12, 0.95);
            box-shadow: 0 35px 100px rgba(0,0,0,0.95);
            backdrop-filter: blur(30px);
            transform: translateY(20px) scale(0.98);
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .chat-overlay.open .chat-window { transform: none; }

        .chat-header {
            height: 62px;
            flex: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            border-bottom: 1px solid var(--border-color);
            background: rgba(255,255,255,0.02);
        }

        .chat-brand { display: flex; gap: 12px; align-items: center; }
        .chat-brand-mark { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: #fff; color: #000; font-weight: 900; }
        .chat-close { border: 0; background: rgba(255,255,255,0.06); color: #aaa; border-radius: 10px; width: 32px; height: 32px; font-size: 18px; cursor: pointer; transition: all 0.2s; }
        .chat-close:hover { color: #fff; background: rgba(255,255,255,0.15); }

        .chat-auth { width: min(390px, 100%); margin: auto; padding: 25px; }
        .chat-auth-title { font-size: 24px; font-weight: 800; }
        .chat-auth-sub { font-size: 12px; color: var(--text-secondary); margin: 6px 0 20px; }
        .chat-tabs { display: flex; gap: 4px; padding: 4px; background: rgba(255,255,255,0.04); border-radius: 12px; margin-bottom: 16px; }
        .chat-auth-tab { flex: 1; border: 0; background: transparent; color: var(--text-secondary); padding: 10px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        .chat-auth-tab.active { background: rgba(255,255,255,0.12); color: #fff; }

        .chat-auth form { display: flex; flex-direction: column; gap: 12px; }
        .chat-auth input, .chat-search-row input, .chat-compose input {
            border: 1px solid var(--border-color);
            background: rgba(255,255,255,0.04);
            color: #fff;
            outline: none;
            border-radius: 12px;
            padding: 12px;
            font: inherit;
            transition: border-color 0.2s;
        }

        .chat-auth input:focus, .chat-search-row input:focus, .chat-compose input:focus {
            border-color: var(--border-hover);
        }

        .chat-primary, .chat-compose button {
            border: 0;
            border-radius: 12px;
            background: #fff;
            color: #000;
            padding: 12px;
            font-weight: 800;
            cursor: pointer;
            transition: background 0.2s;
        }

        .chat-primary:hover, .chat-compose button:hover { background: #e0e0e0; }

        .venusFooter {
            position: fixed;
            bottom: 12px;
            right: 50%;
            transform: translateX(50%);
            color: rgba(255,255,255,0.3);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
            letter-spacing: 1px;
            transition: color 0.2s;
        }

        .venusFooter:hover { color: rgba(255,255,255,0.6); }

        @media (max-width: 600px) {
            .farius-text-logo { font-size: 2.5rem; letter-spacing: 8px; }
            .search-container { max-width: 90%; }
            .app-button { width: 44px; height: 44px; border-radius: 12px; }
            .hohogames-back { left: 12px; bottom: 12px; }
            .farium-chat-launch { right: 12px; bottom: 12px; }
        }
    </style>
</head>
<body>
    <canvas id="particle-canvas" aria-hidden="true"></canvas>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="active" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" title="Settings">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content" id="main-content">
        <div class="logo-container">
            <h1 class="farius-text-logo">FARIUS</h1>
        </div>
        <div class="tagline">Browse Freely</div>
        
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>

        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
