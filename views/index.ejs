        .chat-auth { width:min(390px,100%); margin:auto; padding:25px; } .chat-auth-title{font-size:25px;font-weight:800}.chat-auth-sub{font-size:12px;color:#777;margin:7px 0 18px}.chat-tabs{display:flex;gap:4px;padding:4px;background:rgba(255,255,255,.05);border-radius:11px;margin-bottom:13px}.chat-auth-tab{flex:1;border:0;background:transparent;color:#777;padding:9px;border-radius:8px;cursor:pointer}.chat-auth-tab.active{background:rgba(225,29,46,.18);color:#fff}.chat-auth form{display:flex;flex-direction:column;gap:10px}.chat-auth input,.chat-search-row input,.chat-compose input{border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.045);color:#fff;outline:none;border-radius:10px;padding:11px;font:inherit}.chat-auth input:focus,.chat-search-row input:focus,.chat-compose input:focus{border-color:#e11d2e;box-shadow:0 0 20px rgba(225,29,46,.12)}.chat-primary,.chat-compose button{border:0;border-radius:10px;background:#e11d2e;color:#fff;padding:11px;font-weight:800;cursor:pointer}.chat-primary:hover,.chat-compose button:hover{background:#ff3347}.chat-error{min-height:15px;color:#ff6876;font-size:11px}.avatar-picker label{display:block;color:#bbb;font-size:11px;margin:4px 0 8px}.avatar-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px}.avatar-choice{height:45px;border-radius:12px;border:1px solid rgba(255,255,255,.1);cursor:pointer;color:#fff;font-weight:900}.avatar-choice.selected{border-color:#e11d2e;box-shadow:0 0 0 2px rgba(225,29,46,.15)}.avatar-choice[data-avatar="red"]{background:#e11d2e}.avatar-choice[data-avatar="black"]{background:#111}.avatar-choice[data-avatar="white"]{background:#eee;color:#111}.avatar-choice[data-avatar="crimson"]{background:linear-gradient(135deg,#4a050b,#e11d2e)}.avatar-choice[data-avatar="ember"]{background:linear-gradient(135deg,#211,#c22)}.avatar-choice[data-avatar="mono"]{background:linear-gradient(135deg,#222,#888)}
