<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xylara</title>
    
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-2px)} 30%{transform:translateX(2px)} 45%{transform:translateX(-1px)} 60%{transform:translateX(1px)} }
        @keyframes pulse { 0%,100%{box-shadow:0 0 20px rgba(139,92,246,0.3)} 50%{box-shadow:0 0 40px rgba(139,92,246,0.5)} }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes browserSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes bounceIn { 0%{transform:scale(0.3);opacity:0} 50%{transform:scale(1.05)} 70%{transform:scale(0.95)} 100%{transform:scale(1);opacity:1} }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 0;
            pointer-events: none;
        }

        .topbar {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(15, 15, 22, 0.85);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 5px 10px;
            backdrop-filter: blur(20px);
            animation: fadeIn 0.4s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            transition: all 0.2s;
            text-decoration: none;
        }

        .topbar a:hover { background: rgba(139,92,246,0.25); }
        .topbar a.active { background: rgba(139,92,246,0.3); }
        .customize-button {
            display:flex; align-items:center; justify-content:center;
            width:34px; height:34px; border:0; border-radius:10px;
            background:transparent; color:white; cursor:pointer;
            transition:all .2s;
        }
        .customize-button:hover {
            background:rgba(var(--accent-rgb),.18);
            color:var(--accent-2);
        }
        .customize-button:active { animation:rumble .3s ease; }
        .customize-button svg { width:16px; height:16px; fill:none; stroke:currentColor;
            stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
        .topbar a:active { animation: rumble 0.3s ease; }

        .topbar svg {
            width: 16px;
            height: 16px;
            stroke: white;
            fill: none;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .main-content {
            position: relative;
            z-index: 1;
            text-align: center;
            animation: fadeIn 0.6s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-text {
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: 6px;
            color: #fff;
            margin-bottom: 4px;
            text-shadow: 0 2px 20px rgba(0,0,0,0.5);
        }

        .tagline {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.6);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 28px;
            font-weight: 500;
        }

        .search-container {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 0 auto;
            background: rgba(15, 15, 22, 0.8);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 16px;
            padding: 6px;
            backdrop-filter: blur(20px);
            animation: slideUp 0.6s ease;
            transition: all 0.3s;
        }

        .search-container:focus-within {
            border-color: #8b5cf6;
            box-shadow: 0 0 30px rgba(139,92,246,0.2);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 13px 18px;
            font-size: 0.9rem;
            outline: none;
            background: transparent;
            color: #fff;
            font-family: inherit;
        }

        .search-input::placeholder { color: rgba(255,255,255,0.4); }

        .search-button {
            background: #8b5cf6;
            border: none;
            border-radius: 12px;
            padding: 11px 18px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 15px;
            font-weight: 700;
            transition: all 0.2s;
            font-family: inherit;
            animation: pulse 2.5s infinite;
        }

        .search-button:hover { background: #a78bfa; transform: translateY(-1px); }
        .search-button:active { transform: scale(0.94); animation: rumble 0.3s ease; }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 22px;
            gap: 10px;
            flex-wrap: wrap;
            animation: slideUp 0.6s ease 0.15s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(15, 15, 22, 0.7);
            backdrop-filter: blur(15px);
            cursor: pointer;
            outline: none;
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            text-decoration: none;
            transition: all 0.25s;
            overflow: hidden;
        }

        .app-button:hover {
            background: rgba(139,92,246,0.25);
            border-color: #8b5cf6;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(139,92,246,0.3);
        }

        .app-button:active { transform: scale(0.88); animation: rumble 0.3s ease; }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.85; }
        .app-button:hover img { opacity: 1; }

        #add-app-button {
            background: rgba(15, 15, 22, 0.7);
            border: 1.5px dashed rgba(255,255,255,0.2);
        }

        #add-app-button:hover {
            border-color: #8b5cf6;
            background: rgba(139,92,246,0.15);
        }

        /* BROWSER OVERLAY */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #0a0a0f;
        }

        .browser-overlay.open {
            display: flex;
            animation: browserSlideIn 0.3s ease;
        }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 12px;
            background: #0d0d14;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }

        .browser-toolbar button {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: #8a8a92;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .browser-toolbar button:hover { background: rgba(255,255,255,0.08); color: #fff; }
        .browser-toolbar button:active { animation: rumble 0.3s ease; }

        .browser-toolbar svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 0 14px;
            height: 32px;
            transition: all 0.2s;
        }

        .browser-address:focus-within {
            border-color: #8b5cf6;
            box-shadow: 0 0 20px rgba(139,92,246,0.15);
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: #e8e8f0;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        /* TABS BAR */
        .tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            padding: 5px 8px 0;
            background: #0a0a0f;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 8px 8px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: #8a8a92;
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            max-width: 140px;
            min-width: 60px;
            transition: all 0.15s;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
        }

        .tab:hover { background: rgba(255,255,255,0.04); color: #e8e8f0; }
        .tab.active { background: #111118; color: #fff; border-color: rgba(255,255,255,0.08); border-bottom-color: transparent; font-weight: 600; }

        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: #555;
            cursor: pointer;
            font-size: 9px;
            opacity: 0;
            transition: all 0.15s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.3); color: #ff6b6b; }

        .new-tab-btn {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 1px dashed rgba(255,255,255,0.12);
            background: transparent;
            cursor: pointer;
            color: #555;
            font-size: 14px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 3px;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .new-tab-btn:hover { border-color: #8b5cf6; color: #8b5cf6; background: rgba(139,92,246,0.1); }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: #fff;
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }

        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #0a0a0f;
            z-index: 1;
        }

        .new-tab-page.hidden { display: none; }

        .new-tab-logo {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: 5px;
            color: #8b5cf6;
            margin-bottom: 4px;
        }

        .new-tab-sub { font-size: 0.7rem; color: #555; letter-spacing: 2px; margin-bottom: 22px; }

        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 400px;
            width: 85%;
        }

        .new-tab-search input {
            flex: 1;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 12px 16px;
            color: #fff;
            font-size: 13px;
            outline: none;
            font-family: inherit;
        }

        .new-tab-search input:focus { border-color: #8b5cf6; }

        .new-tab-search button {
            background: #8b5cf6;
            border: none;
            border-radius: 12px;
            padding: 12px 18px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            transition: all 0.2s;
        }

        .new-tab-search button:hover { background: #a78bfa; }

        .venusFooter {
            position: fixed;
            bottom: 10px;
            right: 20px;
            color: rgba(255,255,255,0.5);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
        }

        @media (max-width: 600px) {
            .logo-text { font-size: 1.8rem; }
            .search-container { max-width: 90%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
        }

        /* ===== XYLARA CUSTOMIZATION LAYER =====
           This layer only changes presentation/controls. The existing Scramjet,
           Ultraviolet, BareMux, search, tab and navigation code remains intact. */
        :root {
            --accent: #8b5cf6;
            --accent-2: #a78bfa;
            --surface-alpha: 0.82;
            --shade: 15, 15, 22;
            --scale: 1;
            --blur: 20px;
            --glow: 0.22;
            --shader-opacity: 0;
            --ui-scale: calc(var(--scale) * 1);
        }

        body {
            --accent-rgb: 139, 92, 246;
            transition: background-image .45s ease, filter .35s ease;
        }

        body::after {
            content: '';
            position: fixed;
            inset: -20%;
            z-index: 0;
            pointer-events: none;
            opacity: var(--shader-opacity);
            background:
                radial-gradient(circle at 18% 20%, rgba(var(--accent-rgb), .20), transparent 28%),
                radial-gradient(circle at 82% 78%, rgba(80, 140, 255, .16), transparent 30%),
                linear-gradient(115deg, transparent 25%, rgba(255,255,255,.035) 50%, transparent 75%);
            filter: blur(32px) saturate(125%);
            animation: shaderDrift 12s ease-in-out infinite alternate;
            mix-blend-mode: screen;
        }

        @keyframes shaderDrift {
            from { transform: translate3d(-2%, -1%, 0) rotate(-1deg) scale(1); }
            to { transform: translate3d(2%, 1%, 0) rotate(1deg) scale(1.05); }
        }

        @keyframes browserReveal {
            0% { opacity: 0; transform: translate3d(0, 26px, 0) scale(.985); filter: blur(8px); }
            65% { opacity: 1; transform: translate3d(0, -2px, 0) scale(1.002); filter: blur(0); }
            100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: blur(0); }
        }

        @keyframes browserHide {
            from { opacity: 1; transform: translate3d(0,0,0) scale(1); filter: blur(0); }
            to { opacity: 0; transform: translate3d(0,22px,0) scale(.985); filter: blur(8px); }
        }

        @keyframes panelIn {
            from { opacity: 0; transform: translateY(-8px) scale(.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .topbar, .search-container, .app-button, .browser-address,
        .browser-toolbar, .tabs-bar, .new-tab-search input {
            border-color: rgba(var(--accent-rgb), .16);
        }

        .topbar {
            box-shadow: 0 12px 40px rgba(0,0,0,.24), 0 0 0 1px rgba(var(--accent-rgb), .05);
        }

        .topbar a:hover, .topbar a.active {
            background: rgba(var(--accent-rgb), .18);
            box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), .12);
        }

        .search-container {
            background: rgba(var(--shade), var(--surface-alpha));
            box-shadow: 0 18px 55px rgba(0,0,0,.25);
        }

        .search-container:focus-within,
        .browser-address:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 34px rgba(var(--accent-rgb), var(--glow));
        }

        .search-button, .new-tab-search button {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 10px 28px rgba(var(--accent-rgb), .24);
        }

        .search-button:hover, .new-tab-search button:hover {
            background: linear-gradient(135deg, var(--accent-2), var(--accent));
            box-shadow: 0 14px 34px rgba(var(--accent-rgb), .34);
        }

        .app-button:hover, .new-tab-btn:hover {
            border-color: var(--accent);
            background: rgba(var(--accent-rgb), .14);
            box-shadow: 0 12px 28px rgba(var(--accent-rgb), .18);
        }

        .browser-overlay {
            display: flex;
            visibility: hidden;
            pointer-events: none;
            opacity: 0;
            transform: translate3d(0, 20px, 0) scale(.985);
            filter: blur(7px);
            background: rgba(5,5,9,.96);
            transition: opacity .28s ease, transform .38s cubic-bezier(.2,.8,.2,1), filter .28s ease, visibility 0s linear .38s;
            will-change: transform, opacity, filter;
        }

        .browser-overlay.open {
            visibility: visible;
            pointer-events: auto;
            opacity: 1;
            transform: translate3d(0,0,0) scale(1);
            filter: blur(0);
            animation: browserReveal .5s cubic-bezier(.2,.8,.2,1);
            transition: opacity .28s ease, transform .38s cubic-bezier(.2,.8,.2,1), filter .28s ease, visibility 0s;
        }

        .browser-overlay.closing {
            visibility: visible;
            pointer-events: none;
            opacity: 0;
            transform: translate3d(0,22px,0) scale(.985);
            filter: blur(8px);
            animation: browserHide .32s ease forwards;
            transition: none;
        }

        .browser-toolbar {
            background: linear-gradient(180deg, rgba(18,18,27,.98), rgba(10,10,15,.96));
            box-shadow: 0 8px 30px rgba(0,0,0,.20);
        }

        .browser-toolbar button:hover {
            background: rgba(var(--accent-rgb), .12);
            color: var(--accent-2);
        }

        .browser-address:focus-within { background: rgba(var(--accent-rgb), .07); }
        .tab.active {
            box-shadow: inset 0 2px 0 var(--accent);
        }

        /* Settings / customization panel */
        .customizer-backdrop {
            position: fixed;
            inset: 0;
            z-index: 500;
            background: rgba(0,0,0,.45);
            backdrop-filter: blur(8px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .25s ease, visibility 0s linear .3s;
        }
        .customizer-backdrop.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transition: opacity .25s ease;
        }
        .customizer {
            position: absolute;
            top: 64px;
            right: 18px;
            width: min(360px, calc(100vw - 28px));
            max-height: calc(100vh - 82px);
            overflow: auto;
            padding: 18px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 20px;
            background: rgba(13,13,20,.94);
            box-shadow: 0 30px 90px rgba(0,0,0,.5), 0 0 50px rgba(var(--accent-rgb), .10);
            backdrop-filter: blur(26px) saturate(130%);
            transform: translateY(-8px) scale(.97);
            opacity: 0;
            transition: transform .3s cubic-bezier(.2,.8,.2,1), opacity .25s ease;
        }
        .customizer-backdrop.open .customizer {
            transform: translateY(0) scale(1);
            opacity: 1;
            animation: panelIn .32s cubic-bezier(.2,.8,.2,1);
        }
        .customizer::-webkit-scrollbar { width: 5px; }
        .customizer::-webkit-scrollbar-thumb { background: rgba(255,255,255,.14); border-radius: 99px; }
        .customizer-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }
        .customizer-title { font-size: 15px; font-weight: 800; }
        .customizer-subtitle { margin-top: 3px; font-size: 10px; color: #777; }
        .customizer-close {
            width: 30px; height: 30px; border: 0; border-radius: 10px;
            color: #aaa; background: rgba(255,255,255,.06); cursor: pointer;
            font-size: 16px;
        }
        .customizer-close:hover { color:#fff; background:rgba(255,255,255,.11); }
        .setting-group {
            padding: 13px 0;
            border-top: 1px solid rgba(255,255,255,.07);
        }
        .setting-label {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 9px;
            font-size: 11px;
            font-weight: 700;
            color: #ddd;
        }
        .setting-value { color: var(--accent-2); font-variant-numeric: tabular-nums; }
        .color-row { display:flex; gap:8px; align-items:center; }
        .color-row input[type="color"] {
            width: 44px; height: 34px; padding: 2px; border-radius: 9px;
            border: 1px solid rgba(255,255,255,.12); background:#111; cursor:pointer;
        }
        .preset-row { display:flex; flex-wrap:wrap; gap:7px; }
        .preset {
            width: 27px; height: 27px; border-radius: 9px; border: 1px solid rgba(255,255,255,.14);
            cursor:pointer; box-shadow: 0 4px 14px rgba(0,0,0,.2);
        }
        .range {
            width: 100%;
            accent-color: var(--accent);
            cursor: pointer;
        }
        .toggle-row { display:flex; align-items:center; justify-content:space-between; }
        .toggle {
            position:relative; width:42px; height:24px; border-radius:99px;
            background:#282832; border:1px solid rgba(255,255,255,.1); cursor:pointer;
        }
        .toggle::after {
            content:''; position:absolute; top:3px; left:3px; width:16px; height:16px;
            border-radius:50%; background:#aaa; transition:.22s ease;
        }
        .toggle.on { background:rgba(var(--accent-rgb),.5); border-color:rgba(var(--accent-rgb),.7); }
        .toggle.on::after { left:21px; background:#fff; box-shadow:0 0 12px rgba(255,255,255,.5); }
        .select {
            width:100%; padding:9px 10px; border-radius:10px; color:#eee;
            background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1);
            outline:none; font-family:inherit;
        }
        .reset-settings {
            width:100%; margin-top:8px; padding:9px; border-radius:10px;
            color:#ccc; background:rgba(255,255,255,.05);
            border:1px solid rgba(255,255,255,.1); cursor:pointer; font-family:inherit;
        }
        .reset-settings:hover { background:rgba(255,255,255,.09); color:#fff; }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; }
        }

        body.ui-scaled .topbar { transform: translateX(-50%) scale(var(--scale)); transform-origin: top center; }
        body.ui-scaled .main-content { transform: scale(var(--scale)); }
        body.ui-scaled .browser-toolbar, body.ui-scaled .tabs-bar { font-size: calc(1em * var(--scale)); }

    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="active" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" title="Settings">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <button class="customize-button" id="customize-button" title="Customize appearance" aria-label="Customize appearance">
            <svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="7" r="2"/><circle cx="7" cy="12" r="2"/><circle cx="17" cy="17" r="2"/></svg>
        </button>
    </div>


    <!-- CUSTOMIZATION MENU (presentation only; proxy/search code is untouched) -->
    <div class="customizer-backdrop" id="customizer-backdrop">
        <section class="customizer" role="dialog" aria-label="Xylara customization">
            <div class="customizer-header">
                <div>
                    <div class="customizer-title">Customize Xylara</div>
                    <div class="customizer-subtitle">Colors, shades, shaders and UI scale</div>
                </div>
                <button class="customizer-close" id="customizer-close" aria-label="Close settings">×</button>
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>Accent color</span><span class="setting-value" id="accent-value">#8b5cf6</span></div>
                <div class="color-row">
                    <input type="color" id="accent-color" value="#8b5cf6">
                    <div class="preset-row" id="accent-presets">
                        <button class="preset" data-color="#8b5cf6" style="background:#8b5cf6" aria-label="Purple"></button>
                        <button class="preset" data-color="#06b6d4" style="background:#06b6d4" aria-label="Cyan"></button>
                        <button class="preset" data-color="#3b82f6" style="background:#3b82f6" aria-label="Blue"></button>
                        <button class="preset" data-color="#22c55e" style="background:#22c55e" aria-label="Green"></button>
                        <button class="preset" data-color="#f59e0b" style="background:#f59e0b" aria-label="Amber"></button>
                        <button class="preset" data-color="#ef4444" style="background:#ef4444" aria-label="Red"></button>
                        <button class="preset" data-color="#ec4899" style="background:#ec4899" aria-label="Pink"></button>
                    </div>
                </div>
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>Search bar shade</span><span class="setting-value" id="shade-value">82%</span></div>
                <input class="range" id="shade-range" type="range" min="35" max="98" value="82">
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>Glow intensity</span><span class="setting-value" id="glow-value">22%</span></div>
                <input class="range" id="glow-range" type="range" min="0" max="60" value="22">
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>UI size</span><span class="setting-value" id="scale-value">100%</span></div>
                <input class="range" id="scale-range" type="range" min="80" max="125" value="100">
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>Shader intensity</span><span class="setting-value" id="shader-value">0%</span></div>
                <input class="range" id="shader-range" type="range" min="0" max="70" value="0">
            </div>

            <div class="setting-group">
                <div class="setting-label"><span>Shader style</span></div>
                <select class="select" id="shader-style">
                    <option value="aurora">Aurora glow</option>
                    <option value="soft">Soft glass</option>
                    <option value="vivid">Vivid bloom</option>
                    <option value="none">Off</option>
                </select>
            </div>

            <button class="reset-settings" id="reset-settings">Reset appearance</button>
        </section>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content" id="main-content">
        <div class="logo-text">XYLARA</div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
    </div>

    <!-- BROWSER OVERLAY -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home" style="color: #8b5cf6;">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </button>
            <div class="browser-address">
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
            </div>
            <button id="browser-close" title="Close">
                <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
            </button>
        </div>
        
        <!-- TABS -->
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>

        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer"></iframe>
            <div class="new-tab-page" id="new-tab-page">
                <div class="new-tab-logo">XYLARA</div>
                <div class="new-tab-sub">Browse Freely</div>
                <div class="new-tab-search">
                    <input type="text" id="new-tab-search-input" placeholder="Search or enter URL..." autocomplete="off">
                    <button id="new-tab-search-btn">Go</button>
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="venusFooter">Venus integration</a>

    <script>
        let tabs = [];
        let activeTabId = null;
        let tabIdCounter = 0;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            return __uv$config.prefix + __uv$config.encodeUrl(url);
        }

        function getHostname(url) {
            try { return new URL(url).hostname.replace('www.', ''); } catch(e) { return url.substring(0, 20); }
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) {
                tabs = [];
                addTab(null);
                return;
            }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');

            if (tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }

            document.getElementById('browser-back').disabled = !tab.canGoBack();
            document.getElementById('browser-forward').disabled = !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            renderTabs();
            if (activeTabId === id) {
                loadUrl(url);
            }
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            
            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            frame.src = getProxyUrl(url);
        }

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());
            
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                el.innerHTML = '<span class="tab-title">' + escapeHtml(tab.title || 'New Tab') + '</span>' +
                    (tabs.length > 1 ? '<button class="tab-close">X</button>' : '');
                el.querySelector('.tab-title').addEventListener('click', () => switchTab(tab.id));
                const cb = el.querySelector('.tab-close');
                if (cb) cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                tabsBar.insertBefore(el, document.getElementById('new-tab-btn'));
            });
        }

        function escapeHtml(s) {
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function openBrowser(url) {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('closing');
            overlay.classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('open');
            overlay.classList.add('closing');
            setTimeout(() => {
                if (!overlay.classList.contains('open')) {
                    overlay.classList.remove('closing');
                    tabs = [];
                    activeTabId = null;
                }
            }, 340);
        }

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {}
            }
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}
        }

        document.addEventListener('DOMContentLoaded', () => {
            initProxy();
            const defaultBg = '/foggy-forest.png';
            document.body.style.backgroundImage = `url('${localStorage.getItem('bg') || defaultBg}')`;

            // Main search
            document.getElementById('search-go').addEventListener('click', () => {
                const url = normalizeUrl(document.getElementById('search-input').value);
                if (url) openBrowser(url);
            });
            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('search-go').click();
            });

            // App shortcuts
            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => openBrowser(btn.dataset.url));
            });

            // Browser controls
            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoBack()) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-forward').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoForward()) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-refresh').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.url) loadUrl(tab.url);
            });

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) {
                        const tab = tabs.find(t => t.id === activeTabId);
                        if (tab) navigateInTab(activeTabId, url);
                    }
                }
            });

            // New tab
            document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));
            document.getElementById('new-tab-search-btn').addEventListener('click', () => {
                const input = document.getElementById('new-tab-search-input');
                const url = normalizeUrl(input.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    input.value = '';
                }
            });
            document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
            });

            // Add app

            // ===== Appearance customization =====
            const root = document.documentElement;
            const backdrop = document.getElementById('customizer-backdrop');
            const accentInput = document.getElementById('accent-color');
            const shadeRange = document.getElementById('shade-range');
            const glowRange = document.getElementById('glow-range');
            const scaleRange = document.getElementById('scale-range');
            const shaderRange = document.getElementById('shader-range');
            const shaderStyle = document.getElementById('shader-style');

            function hexToRgb(hex) {
                const n = hex.replace('#','');
                return [
                    parseInt(n.slice(0,2),16),
                    parseInt(n.slice(2,4),16),
                    parseInt(n.slice(4,6),16)
                ].join(', ');
            }

            function applyAppearance(save = true) {
                const accent = accentInput.value;
                root.style.setProperty('--accent', accent);
                root.style.setProperty('--accent-2', accent);
                root.style.setProperty('--accent-rgb', hexToRgb(accent));
                root.style.setProperty('--surface-alpha', (Number(shadeRange.value) / 100).toFixed(2));
                root.style.setProperty('--glow', (Number(glowRange.value) / 100).toFixed(2));
                root.style.setProperty('--scale', (Number(scaleRange.value) / 100).toFixed(2));
                root.style.setProperty('--shader-opacity', (Number(shaderRange.value) / 100).toFixed(2));
                document.body.classList.add('ui-scaled');

                document.getElementById('accent-value').textContent = accent;
                document.getElementById('shade-value').textContent = shadeRange.value + '%';
                document.getElementById('glow-value').textContent = glowRange.value + '%';
                document.getElementById('scale-value').textContent = scaleRange.value + '%';
                document.getElementById('shader-value').textContent = shaderRange.value + '%';

                const style = shaderStyle.value;
                document.body.dataset.shader = style;
                if (style === 'none') {
                    root.style.setProperty('--shader-opacity', '0');
                } else if (style === 'soft') {
                    document.body.style.filter = 'saturate(105%)';
                } else if (style === 'vivid') {
                    document.body.style.filter = 'saturate(125%) contrast(103%)';
                } else {
                    document.body.style.filter = 'none';
                }

                if (save) {
                    localStorage.setItem('xylaraAppearance', JSON.stringify({
                        accent, shade: shadeRange.value, glow: glowRange.value,
                        scale: scaleRange.value, shader: shaderRange.value, shaderStyle: style
                    }));
                }
            }

            function loadAppearance() {
                try {
                    const saved = JSON.parse(localStorage.getItem('xylaraAppearance') || 'null');
                    if (saved) {
                        accentInput.value = saved.accent || '#8b5cf6';
                        shadeRange.value = saved.shade || 82;
                        glowRange.value = saved.glow || 22;
                        scaleRange.value = saved.scale || 100;
                        shaderRange.value = saved.shader || 0;
                        shaderStyle.value = saved.shaderStyle || 'aurora';
                    }
                } catch (e) {}
                applyAppearance(false);
            }

            function openCustomizer() { backdrop.classList.add('open'); }
            function closeCustomizer() { backdrop.classList.remove('open'); }

            // IMPORTANT: the original Settings link still navigates to /settings.
            // The new Customize button opens the appearance panel.
            document.getElementById('customize-button').addEventListener('click', openCustomizer);
            document.getElementById('customizer-close').addEventListener('click', closeCustomizer);
            backdrop.addEventListener('click', (e) => {
                if (e.target === backdrop) closeCustomizer();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeCustomizer();
            });

            [accentInput, shadeRange, glowRange, scaleRange, shaderRange, shaderStyle].forEach(el => {
                el.addEventListener('input', () => applyAppearance(true));
                el.addEventListener('change', () => applyAppearance(true));
            });

            document.querySelectorAll('#accent-presets .preset').forEach(btn => {
                btn.addEventListener('click', () => {
                    accentInput.value = btn.dataset.color;
                    applyAppearance(true);
                });
            });

            document.getElementById('reset-settings').addEventListener('click', () => {
                accentInput.value = '#8b5cf6';
                shadeRange.value = 82;
                glowRange.value = 22;
                scaleRange.value = 100;
                shaderRange.value = 0;
                shaderStyle.value = 'aurora';
                localStorage.removeItem('xylaraAppearance');
                applyAppearance(false);
            });

            loadAppearance();

            document.getElementById('add-app-button').addEventListener('click', () => {
                const name = prompt('App name:');
                if (!name) return;
                const url = prompt('URL (e.g. netflix.com):');
                if (!url) return;
                let fullUrl = url.startsWith('http') ? url : 'https://' + url;
                const domain = new URL(fullUrl).hostname;
                const btn = document.createElement('div');
                btn.className = 'app-button';
                btn.dataset.url = fullUrl;
                btn.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${name}">`;
                btn.addEventListener('click', () => openBrowser(fullUrl));
                btn.addEventListener('contextmenu', (e) => { e.preventDefault(); btn.remove(); });
                document.getElementById('app-buttons').insertBefore(btn, document.getElementById('add-app-button'));
            });
        });
    </script>
</body>
</html>
