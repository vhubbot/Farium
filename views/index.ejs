<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xylara</title>
    
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-2px)} 30%{transform:translateX(2px)} 45%{transform:translateX(-1px)} 60%{transform:translateX(1px)} }
        @keyframes pulse { 0%,100%{box-shadow:0 0 20px rgba(139,92,246,0.3)} 50%{box-shadow:0 0 40px rgba(139,92,246,0.5)} }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 0;
            pointer-events: none;
        }

        .topbar {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(15, 15, 22, 0.85);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 5px 10px;
            backdrop-filter: blur(20px);
            animation: fadeIn 0.4s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            transition: all 0.2s;
            text-decoration: none;
        }

        .topbar a:hover { background: rgba(139,92,246,0.25); }
        .topbar a.active { background: rgba(139,92,246,0.3); }
        .topbar a:active { animation: rumble 0.3s ease; }

        .topbar svg {
            width: 16px;
            height: 16px;
            stroke: white;
            fill: none;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .main-content {
            position: relative;
            z-index: 1;
            text-align: center;
            animation: fadeIn 0.6s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-text {
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: 6px;
            color: #fff;
            margin-bottom: 4px;
            text-shadow: 0 2px 20px rgba(0,0,0,0.5);
        }

        .tagline {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.6);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 28px;
            font-weight: 500;
        }

        .search-container {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 0 auto;
            background: rgba(15, 15, 22, 0.8);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 16px;
            padding: 6px;
            backdrop-filter: blur(20px);
            animation: slideUp 0.6s ease;
            transition: all 0.3s;
        }

        .search-container:focus-within {
            border-color: #8b5cf6;
            box-shadow: 0 0 30px rgba(139,92,246,0.2);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 13px 18px;
            font-size: 0.9rem;
            outline: none;
            background: transparent;
            color: #fff;
            font-family: inherit;
        }

        .search-input::placeholder { color: rgba(255,255,255,0.4); }

        .search-button {
            background: #8b5cf6;
            border: none;
            border-radius: 12px;
            padding: 11px 18px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 15px;
            font-weight: 700;
            transition: all 0.2s;
            font-family: inherit;
            animation: pulse 2.5s infinite;
        }

        .search-button:hover { background: #a78bfa; transform: translateY(-1px); }
        .search-button:active { transform: scale(0.94); animation: rumble 0.3s ease; }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 22px;
            gap: 10px;
            flex-wrap: wrap;
            animation: slideUp 0.6s ease 0.15s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(15, 15, 22, 0.7);
            backdrop-filter: blur(15px);
            cursor: pointer;
            outline: none;
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            text-decoration: none;
            transition: all 0.25s;
            overflow: hidden;
        }

        .app-button:hover {
            background: rgba(139,92,246,0.25);
            border-color: #8b5cf6;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(139,92,246,0.3);
        }

        .app-button:active { transform: scale(0.88); animation: rumble 0.3s ease; }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.85; }
        .app-button:hover img { opacity: 1; }

        #add-app-button {
            background: rgba(15, 15, 22, 0.7);
            border: 1.5px dashed rgba(255,255,255,0.2);
        }

        #add-app-button:hover {
            border-color: #8b5cf6;
            background: rgba(139,92,246,0.15);
        }

        /* BROWSER OVERLAY */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #0a0a0f;
        }

        .browser-overlay.open { display: flex; }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 12px;
            background: #0d0d14;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }

        .browser-toolbar button {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: #8a8a92;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .browser-toolbar button:hover { background: rgba(255,255,255,0.08); color: #fff; }
        .browser-toolbar button:active { animation: rumble 0.3s ease; }

        .browser-toolbar svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 0 14px;
            height: 32px;
            transition: all 0.2s;
        }

        .browser-address:focus-within {
            border-color: #8b5cf6;
            box-shadow: 0 0 20px rgba(139,92,246,0.15);
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: #e8e8f0;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: #fff;
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
        }

        .venusFooter {
            position: fixed;
            bottom: 10px;
            right: 20px;
            color: rgba(255,255,255,0.5);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
        }

        @media (max-width: 600px) {
            .logo-text { font-size: 1.8rem; }
            .search-container { max-width: 90%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="active" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" title="Settings">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content" id="main-content">
        <div class="logo-text">XYLARA</div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
    </div>

    <!-- BROWSER OVERLAY -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home" style="color: #8b5cf6;">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </button>
            <div class="browser-address">
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
            </div>
            <button id="browser-close" title="Close">
                <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
            </button>
        </div>
        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer"></iframe>
        </div>
    </div>

    <a href="#" class="venusFooter">Venus integration</a>

    <script>
        let browserHistory = [];
        let historyIndex = -1;

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            // Always encode through UV
            const encoded = __uv$config.prefix + __uv$config.encodeUrl(url);
            return encoded;
        }

        function openBrowser(url) {
            const overlay = document.getElementById('browser-overlay');
            const frame = document.getElementById('browser-frame');
            const urlInput = document.getElementById('browser-url-input');

            overlay.classList.add('open');
            urlInput.value = url;
            
            // Encode through UV proxy
            const encoded = getProxyUrl(url);
            frame.src = encoded;

            if (historyIndex < browserHistory.length - 1) {
                browserHistory = browserHistory.slice(0, historyIndex + 1);
            }
            browserHistory.push(url);
            historyIndex = browserHistory.length - 1;
        }

        function closeBrowser() {
            document.getElementById('browser-overlay').classList.remove('open');
            browserHistory = [];
            historyIndex = -1;
        }

        function browserGoBack() {
            if (historyIndex > 0) {
                historyIndex--;
                const url = browserHistory[historyIndex];
                document.getElementById('browser-url-input').value = url;
                document.getElementById('browser-frame').src = getProxyUrl(url);
            }
        }

        function browserGoForward() {
            if (historyIndex < browserHistory.length - 1) {
                historyIndex++;
                const url = browserHistory[historyIndex];
                document.getElementById('browser-url-input').value = url;
                document.getElementById('browser-frame').src = getProxyUrl(url);
            }
        }

        function browserRefresh() {
            const currentUrl = document.getElementById('browser-url-input').value;
            if (currentUrl) {
                document.getElementById('browser-frame').src = getProxyUrl(currentUrl);
            }
        }

        function handleSearch(query) {
            const url = normalizeUrl(query);
            if (url) openBrowser(url);
        }

        async function initProxy() {
            // Register service worker for UV
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {
                    console.error('SW registration error:', err);
                }
            }

            // Setup BareMux
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {
                console.error('BareMux init error:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initProxy();

            const defaultBg = '/assets/backgrounds/foggy-forest.png';
            let bg = localStorage.getItem('bg') || defaultBg;
            document.body.style.backgroundImage = `url('${bg}')`;

            // Search
            document.getElementById('search-go').addEventListener('click', () => {
                handleSearch(document.getElementById('search-input').value);
            });

            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') handleSearch(e.target.value);
            });

            // App shortcuts
            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => {
                    openBrowser(btn.dataset.url);
                });
            });

            // Browser controls
            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', browserGoBack);
            document.getElementById('browser-forward').addEventListener('click', browserGoForward);
            document.getElementById('browser-refresh').addEventListener('click', browserRefresh);

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) openBrowser(url);
                }
            });

            // Add app
            document.getElementById('add-app-button').addEventListener('click', () => {
                const name = prompt('App name:');
                if (!name) return;
                const url = prompt('URL (e.g. netflix.com):');
                if (!url) return;
                let fullUrl = url.startsWith('http') ? url : 'https://' + url;
                const domain = new URL(fullUrl).hostname;
                const btn = document.createElement('div');
                btn.className = 'app-button';
                btn.dataset.url = fullUrl;
                btn.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${name}">`;
                btn.addEventListener('click', () => openBrowser(fullUrl));
                btn.addEventListener('contextmenu', (e) => { e.preventDefault(); btn.remove(); });
                document.getElementById('app-buttons').insertBefore(btn, document.getElementById('add-app-button'));
            });
        });
    </script>
</body>
</html>
