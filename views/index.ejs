        .chat-brand { display:flex; gap:10px; align-items:center; } .chat-brand-mark { width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:#e11d2e;color:#fff;font-weight:900;box-shadow:0 0 20px rgba(225,29,46,.3); } .chat-brand small,.chat-room-head small { display:block;color:#777;font-size:10px;margin-top:2px; }
