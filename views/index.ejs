```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farius</title>
    
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-main: #030305;
            --surface-1: rgba(18, 18, 22, 0.75);
            --surface-2: rgba(30, 30, 36, 0.85);
            --accent-glow: rgba(255, 255, 255, 0.12);
            --border-color: rgba(255, 255, 255, 0.1);
            --border-hover: rgba(255, 255, 255, 0.3);
            --text-primary: #ffffff;
            --text-secondary: #8a8a93;
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes browserSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes logoShine {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-main) !important;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.03), transparent 70%),
                        linear-gradient(180deg, #000000 0%, #050508 100%);
            z-index: 0;
            pointer-events: none;
        }

        #particle-canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.6;
        }

        .main-content, .topbar, .browser-overlay, .venusFooter, .farium-chat-launch, .chat-overlay {
            z-index: 10;
        }

        .topbar {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 6px 12px;
            backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            animation: fadeIn 0.6s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
            text-decoration: none;
        }

        .topbar a:hover, .topbar a.active {
            background: rgba(255,255,255,0.1);
            transform: translateY(-2px);
        }

        .topbar svg {
            width: 18px;
            height: 18px;
            stroke: #fff;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .main-content {
            position: relative;
            text-align: center;
            animation: fadeIn 0.8s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-container {
            margin-bottom: 8px;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .farius-text-logo {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: 12px;
            text-transform: uppercase;
            background: linear-gradient(120deg, #ffffff 0%, #8a8a93 30%, #ffffff 60%, #44444c 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: logoShine 6s linear infinite;
            filter: drop-shadow(0 0 25px rgba(255,255,255,0.15));
            cursor: default;
            transition: transform 0.4s ease, filter 0.4s ease;
        }

        .logo-container:hover .farius-text-logo {
            transform: scale(1.03);
            filter: drop-shadow(0 0 35px rgba(255,255,255,0.3));
        }

        .tagline {
            font-size: 0.75rem;
            color: var(--text-secondary);
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 32px;
            font-weight: 600;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .search-container {
            display: flex;
            align-items: center;
            max-width: 540px;
            margin: 0 auto;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 6px;
            backdrop-filter: blur(25px);
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 0 20px 50px rgba(0,0,0,0.9);
        }

        .search-container:focus-within {
            border-color: var(--border-hover);
            box-shadow: 0 0 35px rgba(255, 255, 255, 0.12), 0 20px 50px rgba(0,0,0,0.9);
            transform: translateY(-2px);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 14px 20px;
            font-size: 0.95rem;
            outline: none;
            background: transparent;
            color: #fff;
            font-family: inherit;
        }

        .search-input::placeholder { color: rgba(255,255,255,0.35); }

        .search-button {
            background: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 12px 22px;
            cursor: pointer;
            outline: none;
            color: #000;
            font-size: 14px;
            font-weight: 800;
            transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
            font-family: inherit;
        }

        .search-button:hover { 
            background: #e0e0e0; 
            transform: translateY(-1px);
            box-shadow: 0 5px 20px rgba(255,255,255,0.2);
        }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 28px;
            gap: 12px;
            flex-wrap: wrap;
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 16px;
            background: var(--surface-1);
            backdrop-filter: blur(15px);
            cursor: pointer;
            outline: none;
            border: 1px solid var(--border-color);
            color: white;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            overflow: hidden;
        }

        .app-button:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--border-hover);
            transform: translateY(-4px) scale(1.05);
        }

        .app-button img { width: 22px; height: 22px; object-fit: contain; opacity: 0.8; }
        .app-button:hover img { opacity: 1; }

        .hohogames-back {
            position: fixed;
            left: 22px;
            bottom: 22px;
            z-index: 120;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 18px;
            color: #fff;
            text-decoration: none;
            background: var(--surface-1);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.8);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .hohogames-back:hover {
            transform: translateY(-3px);
            border-color: var(--border-hover);
        }

        .hohogames-back-text strong { display: block; font-size: 11px; letter-spacing: 1.5px; }
        .hohogames-back-text small { color: var(--text-secondary); font-size: 9px; letter-spacing: 1px; }

        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #000000;
        }

        .browser-overlay.open {
            display: flex;
            animation: browserSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            background: #08080a;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .browser-toolbar button {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .browser-toolbar button:hover { background: rgba(255,255,255,0.08); color: #fff; }

        .browser-toolbar svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0 14px;
            height: 34px;
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        .tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            padding: 6px 10px 0;
            background: #040406;
            border-bottom: 1px solid var(--border-color);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 10px 10px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            max-width: 160px;
            min-width: 80px;
            transition: all 0.2s;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
        }

        .tab.active { background: #0e0e12; color: #fff; border-color: var(--border-color); border-bottom-color: transparent; font-weight: 600; }
        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .new-tab-btn {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            border: 1px dashed var(--border-color);
            background: transparent;
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 4px;
            margin-bottom: 4px;
        }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: #000;
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }

        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #000000;
            z-index: 1;
        }

        .new-tab-page.hidden { display: none; }

        .farium-chat-launch {
            position: fixed;
            right: 22px;
            bottom: 22px;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 12px 18px;
            color: #fff;
            background: var(--surface-1);
            backdrop-filter: blur(20px);
            cursor: pointer;
            box-shadow: 0 12px 35px rgba(0,0,0,0.8);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            font: 600 12px Inter, sans-serif;
        }

        .farium-chat-launch:hover {
            transform: translateY(-3px);
            border-color: var(--border-hover);
        }

        .chat-overlay {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(8px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .chat-overlay.open { opacity: 1; visibility: visible; pointer-events: auto; }

        .chat-window {
            width: min(850px, 100%);
            height: min(600px, 90vh);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border-color);
            border-radius: 24px;
            background: rgba(10, 10, 12, 0.95);
            box-shadow: 0 35px 100px rgba(0,0,0,0.95);
        }

        .chat-header {
            height: 60px;
            flex: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            border-bottom: 1px solid var(--border-color);
            background: rgba(255,255,255,0.02);
        }

        .chat-brand { display: flex; gap: 12px; align-items: center; }
        .chat-brand-mark { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; background: #fff; color: #000; font-weight: 900; }
        .chat-close { border: 0; background: rgba(255,255,255,0.06); color: #aaa; border-radius: 10px; width: 32px; height: 32px; font-size: 18px; cursor: pointer; }

        .chat-auth { width: min(380px, 100%); margin: auto; padding: 25px; }
        .chat-auth-title { font-size: 24px; font-weight: 800; }
        .chat-auth-sub { font-size: 12px; color: var(--text-secondary); margin: 6px 0 20px; }
        .chat-tabs { display: flex; gap: 4px; padding: 4px; background: rgba(255,255,255,0.04); border-radius: 12px; margin-bottom: 16px; }
        .chat-auth-tab { flex: 1; border: 0; background: transparent; color: var(--text-secondary); padding: 10px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        .chat-auth-tab.active { background: rgba(255,255,255,0.12); color: #fff; }

        .chat-auth form { display: flex; flex-direction: column; gap: 12px; }
        .chat-auth input {
            border: 1px solid var(--border-color);
            background: rgba(255,255,255,0.04);
            color: #fff;
            outline: none;
            border-radius: 12px;
            padding: 12px;
            font: inherit;
        }

        .chat-error { color: #ff5555; font-size: 11px; min-height: 14px; margin-top: 4px; }

        .chat-app { display: flex; flex: 1; height: calc(100% - 60px); }
        .chat-sidebar { width: 220px; border-right: 1px solid var(--border-color); padding: 16px; display: flex; flex-direction: column; gap: 12px; background: rgba(0,0,0,0.2); }
        .chat-me { font-size: 13px; font-weight: 700; padding: 8px; background: rgba(255,255,255,0.05); border-radius: 10px; text-align: center; }
        .chat-section-title { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin-top: 10px; }
        .chat-friends { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
        .chat-friend-item { padding: 8px; font-size: 12px; border-radius: 8px; background: rgba(255,255,255,0.02); color: #ccc; }
        
        .chat-logout { border: none; background: rgba(255,50,50,0.15); color: #ff6b6b; padding: 10px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 12px; }

        .chat-main { flex: 1; display: flex; flex-direction: column; }
        .chat-room-head { padding: 14px 20px; border-bottom: 1px solid var(--border-color); font-size: 13px; }
        .chat-messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        
        .chat-msg { display: flex; flex-direction: column; gap: 2px; max-width: 80%; }
        .chat-msg.mine { align-self: flex-end; }
        .chat-msg-user { font-size: 10px; color: var(--text-secondary); }
        .chat-msg-text { padding: 10px 14px; border-radius: 14px; background: rgba(255,255,255,0.08); font-size: 13px; line-height: 1.4; word-break: break-word; }
        .chat-msg.mine .chat-msg-text { background: #ffffff; color: #000; font-weight: 500; }

        .chat-compose { display: flex; gap: 8px; padding: 16px; border-top: 1px solid var(--border-color); }
        .chat-compose input { flex: 1; border: 1px solid var(--border-color); background: rgba(255,255,255,0.04); color: #fff; padding: 12px; border-radius: 12px; outline: none; }
        .chat-compose button { border: 0; border-radius: 12px; background: #fff; color: #000; padding: 0 20px; font-weight: 800; cursor: pointer; }

        .venusFooter {
            position: fixed;
            bottom: 12px;
            right: 50%;
            transform: translateX(50%);
            color: rgba(255,255,255,0.3);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
        }
    </style>
</head>
<body>
    <canvas id="particle-canvas"></canvas>

    <div class="topbar">
        <a href="/" class="active" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" title="Settings">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
    </div>

    <div class="main-content" id="main-content">
        <div class="logo-container">
            <h1 class="farius-text-logo">FARIUS</h1>
        </div>
        <div class="tagline">Browse Freely</div>
        
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>

        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com"><img src="/assets/svg/discord.svg" alt="Discord"></div>
            <div class="app-button" data-url="https://youtube.com"><img src="/assets/svg/youtube.svg" alt="YouTube"></div>
            <div class="app-button" data-url="https://spotify.com"><img src="/assets/svg/spotify.svg" alt="Spotify"></div>
            <div class="app-button" data-url="https://github.com"><img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub"></div>
        </div>
    </div>

    <a class="hohogames-back" href="https://sites.google.com/view/hohogames2g/home" target="_blank" rel="noopener noreferrer">
        <span class="hohogames-back-text">
            <strong>GO BACK</strong>
            <small>HOHOGAMES</small>
        </span>
    </a>

    <div class="browser-overlay" id="browser-overlay">
        <div class="browser-toolbar">
            <button id="browser-back">←</button>
            <button id="browser-forward">→</button>
            <button id="browser-refresh">↻</button>
            <button id="browser-home">⌂</button>
            <div class="browser-address">
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
            </div>
            <button id="browser-close">✕</button>
        </div>
        
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn">+</button>
        </div>

        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer"></iframe>
            <div class="new-tab-page" id="new-tab-page">
                <div class="logo-container">
                    <h1 class="farius-text-logo" style="font-size: 2.5rem;">FARIUS</h1>
                </div>
                <div class="tagline">Browse Freely</div>
            </div>
        </div>
    </div>

    <button class="farium-chat-launch" id="farium-chat-launch">
        <span>●</span><span>Chat</span>
    </button>

    <div class="chat-overlay" id="chat-overlay">
        <div class="chat-window">
            <header class="chat-header">
                <div class="chat-brand">
                    <div class="chat-brand-mark">F</div>
                    <div><strong>Farius Chat</strong></div>
                </div>
                <button class="chat-close" id="chat-close">✕</button>
            </header>
            
            <div class="chat-auth" id="chat-auth">
                <div class="chat-auth-title" id="auth-title">Welcome Back</div>
                <div class="chat-auth-sub" id="auth-sub">Sign in to join the discussion.</div>
                <div class="chat-tabs">
                    <button class="chat-auth-tab active" id="tab-login">Sign in</button>
                    <button class="chat-auth-tab" id="tab-register">Sign up</button>
                </div>
                <form id="chat-auth-form">
                    <input id="chat-username" placeholder="Username" autocomplete="username" required>
                    <input id="chat-password" type="password" placeholder="Password" autocomplete="current-password" required>
                    <button class="search-button" type="submit" id="chat-auth-submit" style="width: 100%; margin-top: 10px;">Sign in</button>
                    <div class="chat-error" id="chat-auth-error"></div>
                </form>
            </div>

            <div class="chat-app" id="chat-app" style="display: none;">
                <aside class="chat-sidebar">
                    <div class="chat-me" id="chat-me">User</div>
                    <div class="chat-section-title">Online Members</div>
                    <div class="chat-friends" id="chat-friends">
                        <div class="chat-friend-item">● General Lounge</div>
                        <div class="chat-friend-item">● Alex</div>
                        <div class="chat-friend-item">● Nova</div>
                    </div>
                    <button class="chat-logout" id="chat-logout">Sign out</button>
                </aside>
                <main class="chat-main">
                    <div class="chat-room-head"><strong># Global Chat</strong></div>
                    <div class="chat-messages" id="chat-messages"></div>
                    <form class="chat-compose" id="chat-compose">
                        <input id="chat-message-input" placeholder="Type a message..." autocomplete="off">
                        <button type="submit">Send</button>
                    </form>
                </main>
            </div>
        </div>
    </div>

    <a href="#" class="venusFooter">Venus Integration</a>

    <script>
        // --- BAREMUX & ULTRAVIOLET PROXY INITIALIZATION ---
        let swRegistered = false;

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/uv/sw.js', {
                        scope: __uv$config.prefix
                    });
                    if (window.BareMux) {
                        const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                        await connection.setTransport("/epoxy/index.mjs", [{ bare: "https://bare.benrogo.net" }]);
                    }
                    swRegistered = true;
                } catch (err) {
                    console.warn("Proxy registration state:", err.message);
                }
            }
        }
        initProxy();

        // --- BROWSER ENGINE & TAB SYSTEM ---
        let tabs = [];
        let activeTabId = null;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
            }
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            if (window.__uv$config && window.__uv$config.encodeUrl) {
                return __uv$config.prefix + __uv$config.encodeUrl(url);
            }
            return url;
        }

        function addTab(url) {
            const id = 't_' + Date.now() + Math.random().toString(36).substr(2, 4);
            const tab = new Tab(id, url, url ? new URL(url).hostname : 'New Tab');
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) loadUrl(url);
        }

        function switchTab(id) {
            activeTabId = id;
            renderTabs();
            const tab = tabs.find(t => t.id === id);
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');

            if (tab && tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            frame.src = getProxyUrl(url);
        }

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                el.innerHTML = `<span class="tab-title">${tab.title}</span><button class="tab-close">✕</button>`;
                el.querySelector('.tab-title').addEventListener('click', () => switchTab(tab.id));
                el.querySelector('.tab-close').addEventListener('click', (e) => {
                    e.stopPropagation();
                    tabs = tabs.filter(t => t.id !== tab.id);
                    if (tabs.length === 0) closeBrowser();
                    else switchTab(tabs[0].id);
                });
                tabsBar.insertBefore(el, document.getElementById('new-tab-btn'));
            });
        }

        function openBrowser(url) {
            document.getElementById('browser-overlay').classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            document.getElementById('browser-overlay').classList.remove('open');
            tabs = [];
            activeTabId = null;
        }

        // --- REAL-TIME FUNCTIONAL CHAT SYSTEM ---
        let authMode = 'login';
        let currentUser = JSON.parse(localStorage.getItem('farius_session')) || null;

        const chatOverlay = document.getElementById('chat-overlay');
        const chatAuth = document.getElementById('chat-auth');
        const chatApp = document.getElementById('chat-app');
        const authError = document.getElementById('chat-auth-error');

        function updateChatState() {
            if (currentUser) {
                chatAuth.style.display = 'none';
                chatApp.style.display = 'flex';
                document.getElementById('chat-me').textContent = currentUser.username;
                renderMessages();
            } else {
                chatAuth.style.display = 'block';
                chatApp.style.display = 'none';
            }
        }

        document.getElementById('tab-login').addEventListener('click', () => {
            authMode = 'login';
            document.getElementById('tab-login').classList.add('active');
            document.getElementById('tab-register').classList.remove('active');
            document.getElementById('auth-title').textContent = 'Welcome Back';
            document.getElementById('chat-auth-submit').textContent = 'Sign in';
            authError.textContent = '';
        });

        document.getElementById('tab-register').addEventListener('click', () => {
            authMode = 'register';
            document.getElementById('tab-register').classList.add('active');
            document.getElementById('tab-login').classList.remove('active');
            document.getElementById('auth-title').textContent = 'Create Account';
            document.getElementById('chat-auth-submit').textContent = 'Sign up';
            authError.textContent = '';
        });

        document.getElementById('chat-auth-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const userVal = document.getElementById('chat-username').value.trim();
            const passVal = document.getElementById('chat-password').value;
            const users = JSON.parse(localStorage.getItem('farius_users')) || {};

            if (authMode === 'register') {
                if (users[userVal]) {
                    authError.textContent = 'Username is already taken.';
                    return;
                }
                users[userVal] = { password: passVal };
                localStorage.setItem('farius_users', JSON.stringify(users));
                currentUser = { username: userVal };
                localStorage.setItem('farius_session', JSON.stringify(currentUser));
                updateChatState();
            } else {
                if (!users[userVal] || users[userVal].password !== passVal) {
                    authError.textContent = 'Invalid username or password.';
                    return;
                }
                currentUser = { username: userVal };
                localStorage.setItem('farius_session', JSON.stringify(currentUser));
                updateChatState();
            }
        });

        document.getElementById('chat-logout').addEventListener('click', () => {
            currentUser = null;
            localStorage.removeItem('farius_session');
            updateChatState();
        });

        function getMessages() {
            return JSON.parse(localStorage.getItem('farius_messages')) || [
                { user: 'System', text: 'Welcome to Farius Lounge! Chat with others in real-time.' }
            ];
        }

        function renderMessages() {
            const container = document.getElementById('chat-messages');
            const msgs = getMessages();
            container.innerHTML = msgs.map(m => `
                <div class="chat-msg ${currentUser && m.user === currentUser.username ? 'mine' : ''}">
                    <span class="chat-msg-user">${m.user}</span>
                    <div class="chat-msg-text">${escapeHtml(m.text)}</div>
                </div>
            `).join('');
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.getElementById('chat-compose').addEventListener('submit', (e) => {
            e.preventDefault();
            const input = document.getElementById('chat-message-input');
            const text = input.value.trim();
            if (!text || !currentUser) return;

            const msgs = getMessages();
            msgs.push({ user: currentUser.username, text: text });
            localStorage.setItem('farius_messages', JSON.stringify(msgs));
            input.value = '';
            renderMessages();
        });

        window.addEventListener('storage', (e) => {
            if (e.key === 'farius_messages') renderMessages();
        });

        // Event Bindings
        document.getElementById('farium-chat-launch').addEventListener('click', () => {
            chatOverlay.classList.add('open');
            updateChatState();
        });
        document.getElementById('chat-close').addEventListener('click', () => chatOverlay.classList.remove('open'));
        
        document.getElementById('search-go').addEventListener('click', () => {
            const url = normalizeUrl(document.getElementById('search-input').value);
            if (url) openBrowser(url);
        });
        document.getElementById('search-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('search-go').click();
        });
        document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
            btn.addEventListener('click', () => openBrowser(btn.dataset.url));
        });
        document.getElementById('browser-close').addEventListener('click', closeBrowser);
        document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));

        // Background Animation
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resize() { canvas.width = innerWidth; canvas.height = innerHeight; }
        function initParticles() {
            particles = Array.from({ length: 40 }, () => ({
                x: Math.random() * innerWidth, y: Math.random() * innerHeight,
                r: Math.random() * 1.5 + 0.5, vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2
            }));
        }
        function draw() {
            ctx.clearRect(0, 0, innerWidth, innerHeight);
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            particles.forEach(p => {
                p.x += p.vx; p.y += p.vy;
                if (p.x < 0) p.x = innerWidth; if (p.x > innerWidth) p.x = 0;
                if (p.y < 0) p.y = innerHeight; if (p.y > innerHeight) p.y = 0;
                ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
            });
            requestAnimationFrame(draw);
        }
        window.addEventListener('resize', () => { resize(); initParticles(); });
        resize(); initParticles(); draw();
    </script>
</body>
</html>

