        body.ui-scaled .topbar { transform: translateX(-50%) scale(var(--scale)); transform-origin: top center; }
        body.ui-scaled .main-content { transform: scale(var(--scale)); }
        body.ui-scaled .browser-toolbar, body.ui-scaled .tabs-bar { font-size: calc(1em * var(--scale)); }


        /* ===== FARIUM PARTICLES ===== */
